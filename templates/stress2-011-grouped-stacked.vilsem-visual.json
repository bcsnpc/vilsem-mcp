{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_011_grouped-stacked",
      "name": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
      "description": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      },
      "m3": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Bike Cost",
          "stack": "bikes",
          "data": "$slot.m0.values"
        },
        {
          "type": "bar",
          "name": "Bike Profit",
          "stack": "bikes",
          "data": "$slot.m1.values"
        },
        {
          "type": "bar",
          "name": "Clothing Cost",
          "stack": "clothing",
          "data": "$slot.m2.values"
        },
        {
          "type": "bar",
          "name": "Clothing Profit",
          "stack": "clothing",
          "data": "$slot.m3.values"
        }
      ]
    }
  },
  "measures": {
    "Stress Bike Cost": "CALCULATE([Total Cost], 'Product Categories Lookup'[CategoryName] = \"Bikes\")",
    "Stress Bike Profit": "CALCULATE([Total Profit], 'Product Categories Lookup'[CategoryName] = \"Bikes\")",
    "Stress Clothing Cost": "CALCULATE([Total Cost], 'Product Categories Lookup'[CategoryName] = \"Clothing\")",
    "Stress Clothing Profit": "CALCULATE([Total Profit], 'Product Categories Lookup'[CategoryName] = \"Clothing\")"
  }
}
