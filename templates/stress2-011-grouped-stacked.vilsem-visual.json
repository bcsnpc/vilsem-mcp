{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_011_grouped-stacked",
      "name": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
      "description": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      },
      "m3": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "11 \u00b7 Country revenue stacks \u00b7 Bikes and Clothing",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "#263244"
          }
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Bike Cost",
          "stack": "bikes",
          "data": "$slot.m0.values"
        },
        {
          "type": "bar",
          "name": "Bike Profit",
          "stack": "bikes",
          "data": "$slot.m1.values"
        },
        {
          "type": "bar",
          "name": "Clothing Cost",
          "stack": "clothing",
          "data": "$slot.m2.values"
        },
        {
          "type": "bar",
          "name": "Clothing Profit",
          "stack": "clothing",
          "data": "$slot.m3.values"
        }
      ]
    }
  },
  "measures": {
    "Stress Bike Cost": "CALCULATE([Total Cost], 'Product Categories Lookup'[CategoryName] = \"Bikes\")",
    "Stress Bike Profit": "CALCULATE([Total Profit], 'Product Categories Lookup'[CategoryName] = \"Bikes\")",
    "Stress Clothing Cost": "CALCULATE([Total Cost], 'Product Categories Lookup'[CategoryName] = \"Clothing\")",
    "Stress Clothing Profit": "CALCULATE([Total Profit], 'Product Categories Lookup'[CategoryName] = \"Clothing\")"
  }
}