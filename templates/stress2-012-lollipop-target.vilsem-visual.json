{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_012_lollipop-target",
      "name": "12 \u00b7 Country revenue lollipops and target markers",
      "description": "12 \u00b7 Country revenue lollipops and target markers",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "12 \u00b7 Country revenue lollipops and target markers",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Revenue stem",
          "barWidth": 3,
          "data": "$slot.m0.values"
        },
        {
          "type": "scatter",
          "name": "Revenue",
          "symbolSize": 13,
          "data": "$slot.m0.pairs"
        },
        {
          "type": "scatter",
          "name": "Target",
          "symbol": "rect",
          "symbolSize": [
            25,
            4
          ],
          "data": "$slot.m1.pairs",
          "itemStyle": {
            "color": "#f59e0b"
          }
        }
      ]
    }
  }
}
