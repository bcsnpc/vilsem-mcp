{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_096_ridgeline",
      "name": "96 - Retail-price ridgelines by subcategory - kernel density",
      "description": "96 - Retail-price ridgelines by subcategory - kernel density",
      "formatVersion": 3
    },
    "slots": {
      "subcategory": {
        "kind": "dimension"
      },
      "product": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "sold": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "96 - Retail-price ridgelines by subcategory - kernel density",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{label}"
      },
      "grid": {
        "left": 190,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:thousands}"
        },
        "min": "$calc.density.min",
        "max": "$calc.density.max"
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "show": false
        },
        "min": -0.5,
        "max": "$calc.density.categories.length"
      },
      "series": {
        "repeat": "$calc.density.panels",
        "template": {
          "type": "line",
          "name": "$item.name",
          "data": "$item.data",
          "showSymbol": false,
          "areaStyle": {
            "opacity": 0.6,
            "origin": "$item.index"
          },
          "lineStyle": {
            "width": 1
          },
          "markPoint": {
            "symbolSize": 1,
            "itemStyle": {
              "opacity": 0
            },
            "silent": true,
            "label": {
              "show": true,
              "opacity": 1,
              "position": "left",
              "fontSize": 8,
              "width": 150,
              "overflow": "truncate",
              "color": "#cbd5e1",
              "formatterTemplate": "{name}"
            },
            "data": [
              {
                "name": "$item.name",
                "coord": [
                  "$calc.density.min",
                  "$item.index"
                ]
              }
            ]
          }
        }
      }
    },
    "transforms": [
      {
        "density": {
          "by": "subcategory",
          "field": "price",
          "layout": "ridgeline",
          "samples": 64
        },
        "as": "density"
      }
    ]
  }
}