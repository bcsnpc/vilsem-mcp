{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_104_ytd-prior-year",
      "name": "104 - Year-to-date revenue versus same-period prior year",
      "description": "104 - Year-to-date revenue versus same-period prior year",
      "formatVersion": 3
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "current": {
        "kind": "measure"
      },
      "prior": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "104 - Year-to-date revenue versus same-period prior year",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "YTD",
          "data": "$slot.current.values",
          "showSymbol": false
        },
        {
          "type": "line",
          "name": "Prior-year YTD",
          "data": "$slot.prior.values",
          "showSymbol": false
        }
      ]
    }
  },
  "measures": {
    "Stress Prior YTD": "CALCULATE([YTD Revenue], SAMEPERIODLASTYEAR('Calendar Lookup'[Date]))"
  }
}
