{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_095_ecdf",
      "name": "95 - Empirical cumulative retail-price distribution of sold products",
      "description": "95 - Empirical cumulative retail-price distribution of sold products",
      "formatVersion": 3
    },
    "slots": {
      "product": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "sold": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "95 - Empirical cumulative retail-price distribution of sold products",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:percent}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "min": 0,
        "max": 1
      },
      "series": [
        {
          "type": "line",
          "step": "end",
          "data": "$calc.cdf.data",
          "showSymbol": false
        }
      ]
    },
    "transforms": [
      {
        "ecdf": {
          "field": "price"
        },
        "as": "cdf"
      }
    ]
  }
}
