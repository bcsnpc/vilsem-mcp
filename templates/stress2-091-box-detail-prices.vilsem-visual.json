{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_091_box-detail-prices",
      "name": "91 - Retail prices by product subcategory - quartiles, whiskers, outliers",
      "description": "91 - Retail prices by product subcategory - quartiles, whiskers, outliers",
      "formatVersion": 3
    },
    "slots": {
      "subcategory": {
        "kind": "dimension"
      },
      "product": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "sold": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "91 - Retail prices by product subcategory - quartiles, whiskers, outliers",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 150,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.box.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 50,
          "hideOverlap": true,
          "fontSize": 9
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "boxplot",
          "name": "Price distribution",
          "data": "$calc.box.boxes"
        },
        {
          "type": "scatter",
          "name": "Outliers",
          "data": "$calc.box.outliers",
          "symbolSize": 5
        }
      ]
    },
    "transforms": [
      {
        "boxplot": {
          "by": "subcategory",
          "field": "price",
          "whisker": 1.5
        },
        "as": "box"
      }
    ]
  }
}
