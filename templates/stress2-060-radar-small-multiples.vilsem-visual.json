{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_060_radar-small-multiples",
      "name": "60 - Category revenue radar - one panel per country",
      "description": "60 - Category revenue radar - one panel per country",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "60 - Category revenue radar - one panel per country",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "radar": [
        {
          "center": [
            "18%",
            "36%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        },
        {
          "center": [
            "50%",
            "36%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        },
        {
          "center": [
            "82%",
            "36%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        },
        {
          "center": [
            "18%",
            "76%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        },
        {
          "center": [
            "50%",
            "76%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        },
        {
          "center": [
            "82%",
            "76%"
          ],
          "radius": 95,
          "indicator": "$calc.facets.indicators",
          "axisName": {
            "color": "$theme.textPrimary",
            "fontSize": 9
          },
          "splitArea": {
            "show": false
          }
        }
      ],
      "series": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "radar",
          "name": "$item.name",
          "radarIndex": "$item.index",
          "data": [
            {
              "name": "$item.name",
              "value": "$item.values",
              "rowIndexes": "$item.rowIndexes"
            }
          ],
          "areaStyle": {
            "opacity": 0.15
          }
        }
      },
      "graphic": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "text",
          "left": "$item.left",
          "top": "$item.top",
          "style": {
            "text": "$item.name",
            "fill": "$theme.textPrimary",
            "fontSize": 13
          }
        }
      }
    },
    "transforms": [
      {
        "facet": {
          "by": "country",
          "category": "category",
          "value": "revenue",
          "columns": 3,
          "maxPanels": 6
        },
        "as": "facets"
      }
    ]
  }
}
