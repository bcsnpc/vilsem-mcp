{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_001_step-line",
      "name": "01 \u00b7 Revenue step: start / middle / end",
      "description": "01 \u00b7 Revenue step: start / middle / end",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "01 \u00b7 Revenue step: start / middle / end",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "start",
          "step": "start",
          "showSymbol": false,
          "data": "$slot.m0.values"
        },
        {
          "type": "line",
          "name": "middle",
          "step": "middle",
          "showSymbol": false,
          "data": "$slot.m1.values"
        },
        {
          "type": "line",
          "name": "end",
          "step": "end",
          "showSymbol": false,
          "data": "$slot.m2.values"
        }
      ]
    }
  },
  "measures": {
    "Step Start": "[Total Revenue]",
    "Step Middle": "[Total Revenue]",
    "Step End": "[Total Revenue]"
  }
}
