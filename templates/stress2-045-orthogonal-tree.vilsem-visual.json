{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_045_orthogonal-tree",
      "name": "45 - Category to subcategory revenue - orthogonal tree",
      "description": "45 - Category to subcategory revenue - orthogonal tree",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "subcategory": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "45 - Category to subcategory revenue - orthogonal tree",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "series": [
        {
          "type": "tree",
          "data": [
            {
              "name": "Products",
              "children": "$calc.tree.children"
            }
          ],
          "top": 90,
          "bottom": 50,
          "left": 100,
          "right": 180,
          "layout": "orthogonal",
          "orient": "LR",
          "edgeShape": "polyline",
          "initialTreeDepth": -1,
          "expandAndCollapse": true,
          "symbolSize": 10,
          "label": {
            "position": "left",
            "color": "$theme.textPrimary",
            "fontSize": 11
          },
          "leaves": {
            "label": {
              "position": "right",
              "formatterTemplate": "{name}",
              "color": "$theme.textPrimary",
              "fontSize": 10
            }
          },
          "lineStyle": {
            "color": "#64748b"
          },
          "itemStyle": {
            "color": "#2dd4bf"
          }
        }
      ]
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory"
          ],
          "value": "revenue"
        },
        "as": "tree"
      }
    ]
  }
}
