{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_101_group-percent-subtotals",
      "name": "101 - Category share within country - country revenue subtotals",
      "description": "101 - Category share within country - country revenue subtotals",
      "formatVersion": 3
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "101 - Category share within country - country revenue subtotals",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 180,
        "right": 40,
        "top": 90,
        "bottom": 60,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "min": 0,
        "max": 1.15,
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:percent}",
          "showMaxLabel": false
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$calc.shares.categories",
        "axisLabel": {
          "color": "#cbd5e1",
          "fontSize": 9
        }
      },
      "series": [
        {
          "type": "bar",
          "data": "$calc.shares.data",
          "label": {
            "show": true,
            "position": "right",
            "formatterTemplate": "{value:percent}",
            "color": "#cbd5e1",
            "fontSize": 10
          }
        }
      ]
    },
    "transforms": [
      {
        "groupShare": {
          "by": "country",
          "category": "category",
          "value": "revenue",
          "subtotals": true
        },
        "as": "shares"
      }
    ]
  }
}