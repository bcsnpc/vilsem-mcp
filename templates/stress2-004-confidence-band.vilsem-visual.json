{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_004_confidence-band",
      "name": "04 \u00b7 Mean sales-line revenue \u00b7 approximate 95% interval",
      "description": "04 \u00b7 Mean sales-line revenue \u00b7 approximate 95% interval",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "04 \u00b7 Mean sales-line revenue \u00b7 approximate 95% interval",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "data": [
          "95% interval",
          "Mean"
        ]
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "#263244"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "Lower",
          "stack": "ci",
          "data": "$slot.m0.values",
          "lineStyle": {
            "opacity": 0
          },
          "symbol": "none",
          "areaStyle": {
            "opacity": 0
          }
        },
        {
          "type": "line",
          "name": "95% interval",
          "stack": "ci",
          "data": "$calc.span.values",
          "symbol": "none",
          "lineStyle": {
            "opacity": 0
          },
          "areaStyle": {
            "color": "#60a5fa",
            "opacity": 0.25
          },
          "itemStyle": {
            "color": "#60a5fa"
          }
        },
        {
          "type": "line",
          "name": "Mean",
          "data": "$slot.m2.values",
          "symbol": "none",
          "lineStyle": {
            "color": "#f59e0b"
          },
          "itemStyle": {
            "color": "#f59e0b"
          }
        }
      ]
    },
    "transforms": [
      {
        "calculate": "m1-m0",
        "as": "span"
      }
    ]
  },
  "measures": {
    "Stress CI Low": "AVERAGEX('Sales Data', 'Sales Data'[Revenue]) - 1.96 * DIVIDE(STDEVX.P('Sales Data', 'Sales Data'[Revenue]), SQRT(COUNTROWS('Sales Data')))",
    "Stress CI High": "AVERAGEX('Sales Data', 'Sales Data'[Revenue]) + 1.96 * DIVIDE(STDEVX.P('Sales Data', 'Sales Data'[Revenue]), SQRT(COUNTROWS('Sales Data')))",
    "Stress Mean": "AVERAGEX('Sales Data', 'Sales Data'[Revenue])"
  }
}