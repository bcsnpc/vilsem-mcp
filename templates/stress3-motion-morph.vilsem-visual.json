{
  "version": 1,
  "specVersion": "0.7",
  "type": "custom",
  "bindings": {
    "dimensions": [
      {
        "table": "Territory Lookup",
        "column": "Country"
      }
    ],
    "measures": [
      {
        "table": "Measure Table",
        "name": "Total Revenue"
      }
    ]
  },
  "template": {
    "meta": {
      "id": "stress3-motion-morph",
      "name": "morph real-data motion",
      "formatVersion": 4
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "transforms": [],
    "animation": {
      "enter": {
        "duration": 500
      },
      "update": {
        "duration": 600,
        "easing": "cubicInOut"
      }
    },
    "template": {
      "baseOption": {
        "title": {
          "text": "One revenue dataset — bar / pie / scatter",
          "subtext": "Real model values · discrete preview states; live interpolation needs verification",
          "left": 25,
          "top": 10,
          "textStyle": {
            "fontSize": 18
          },
          "subtextStyle": {
            "color": "#555555",
            "fontSize": 11
          }
        },
        "timeline": {
          "axisType": "category",
          "autoPlay": true,
          "playInterval": 800,
          "data": [
            "Bar",
            "Pie",
            "Scatter"
          ],
          "bottom": 5,
          "label": {
            "show": false
          }
        },
        "grid": {
          "left": 100,
          "right": 45,
          "top": 90,
          "bottom": 85
        },
        "xAxis": {
          "type": "category",
          "data": "$slot.country.categories"
        },
        "yAxis": {
          "type": "value",
          "axisLabel": {
            "formatterTemplate": "{value:thousands}"
          }
        }
      },
      "options": [
        {
          "xAxis": {
            "show": true
          },
          "yAxis": {
            "show": true
          },
          "series": [
            {
              "id": "morph",
              "universalTransition": {
                "enabled": true,
                "divideShape": "clone"
              },
              "type": "bar",
              "data": "$slot.revenue.pieData"
            }
          ]
        },
        {
          "xAxis": {
            "show": false
          },
          "yAxis": {
            "show": false
          },
          "series": [
            {
              "id": "morph",
              "universalTransition": {
                "enabled": true,
                "divideShape": "clone"
              },
              "type": "pie",
              "radius": "55%",
              "center": [
                "50%",
                "50%"
              ],
              "data": "$slot.revenue.pieData"
            }
          ]
        },
        {
          "xAxis": {
            "show": true
          },
          "yAxis": {
            "show": true
          },
          "series": [
            {
              "id": "morph",
              "universalTransition": {
                "enabled": true,
                "divideShape": "clone"
              },
              "type": "scatter",
              "symbolSize": 20,
              "data": "$slot.revenue.pairs"
            }
          ]
        }
      ]
    }
  }
}
