{
  "version": 1,
  "specVersion": "0.7",
  "type": "custom",
  "bindings": {
    "dimensions": [
      {
        "table": "Calendar Lookup",
        "column": "Date"
      }
    ],
    "measures": [
      {
        "table": "Measure Table",
        "name": "Total Revenue"
      }
    ]
  },
  "template": {
    "meta": {
      "id": "stress3-motion-zoom-autoplay",
      "name": "zoom-autoplay real-data motion",
      "formatVersion": 4
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "transforms": [],
    "animation": {
      "enter": {
        "duration": 500
      },
      "update": {
        "duration": 600,
        "easing": "cubicInOut"
      }
    },
    "template": {
      "baseOption": {
        "title": {
          "text": "Daily revenue — autoplay through date windows",
          "subtext": "Real model values · discrete preview states; live interpolation needs verification",
          "left": 25,
          "top": 10,
          "textStyle": {
            "fontSize": 18
          },
          "subtextStyle": {
            "color": "#555555",
            "fontSize": 11
          }
        },
        "timeline": {
          "axisType": "category",
          "autoPlay": true,
          "playInterval": 800,
          "data": [
            "Window 1",
            "Window 2",
            "Window 3",
            "Window 4",
            "Window 5"
          ],
          "bottom": 5,
          "label": {
            "show": false
          }
        },
        "grid": {
          "left": 100,
          "right": 45,
          "top": 90,
          "bottom": 180
        },
        "xAxis": {
          "type": "category",
          "data": "$slot.date.categories",
          "axisLabel": {
            "formatterTemplate": "{value:date}"
          }
        },
        "yAxis": {
          "type": "value",
          "axisLabel": {
            "formatterTemplate": "{value:thousands}"
          }
        },
        "dataZoom": [
          {
            "id": "window",
            "type": "slider",
            "start": 0,
            "end": 20,
            "bottom": 85
          },
          {
            "type": "inside",
            "start": 0,
            "end": 20
          }
        ],
        "series": [
          {
            "id": "daily",
            "type": "line",
            "showSymbol": false,
            "data": "$slot.revenue.values"
          }
        ]
      },
      "options": [
        {
          "dataZoom": [
            {
              "id": "window",
              "start": 0,
              "end": 20
            },
            {
              "type": "inside",
              "start": 0,
              "end": 20
            }
          ]
        },
        {
          "dataZoom": [
            {
              "id": "window",
              "start": 20,
              "end": 40
            },
            {
              "type": "inside",
              "start": 20,
              "end": 40
            }
          ]
        },
        {
          "dataZoom": [
            {
              "id": "window",
              "start": 40,
              "end": 60
            },
            {
              "type": "inside",
              "start": 40,
              "end": 60
            }
          ]
        },
        {
          "dataZoom": [
            {
              "id": "window",
              "start": 60,
              "end": 80
            },
            {
              "type": "inside",
              "start": 60,
              "end": 80
            }
          ]
        },
        {
          "dataZoom": [
            {
              "id": "window",
              "start": 80,
              "end": 100
            },
            {
              "type": "inside",
              "start": 80,
              "end": 100
            }
          ]
        }
      ]
    }
  }
}
