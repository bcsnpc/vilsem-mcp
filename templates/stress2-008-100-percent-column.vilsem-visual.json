{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_008_100-percent-column",
      "name": "08 \u00b7 Revenue composition \u00b7 profit and cost share",
      "description": "08 \u00b7 Revenue composition \u00b7 profit and cost share",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "08 \u00b7 Revenue composition \u00b7 profit and cost share",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:percent}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "max": 1
      },
      "series": [
        {
          "type": "bar",
          "name": "Profit share",
          "stack": "share",
          "data": "$slot.m0.values",
          "label": {
            "show": true,
            "formatterTemplate": "{value:percent}",
            "color": "$theme.paletteText.0",
            "position": "inside"
          }
        },
        {
          "type": "bar",
          "name": "Cost share",
          "stack": "share",
          "data": "$slot.m1.values",
          "label": {
            "show": true,
            "formatterTemplate": "{value:percent}",
            "color": "$theme.paletteText.1",
            "position": "inside"
          }
        }
      ]
    }
  },
  "measures": {
    "Stress Profit Share": "DIVIDE([Total Profit],[Total Revenue])",
    "Stress Cost Share": "DIVIDE([Total Cost],[Total Revenue])"
  }
}
