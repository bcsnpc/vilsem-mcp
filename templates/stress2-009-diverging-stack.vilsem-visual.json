{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_009_diverging-stack",
      "name": "09 \u00b7 Country economics \u00b7 diverging stacked balances",
      "description": "09 \u00b7 Country economics \u00b7 diverging stacked balances",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "09 \u00b7 Country economics \u00b7 diverging stacked balances",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Cost (outflow)",
          "stack": "balance",
          "data": "$slot.m0.values",
          "stackStrategy": "samesign",
          "labelLayout": {
            "hideOverlap": true
          },
          "label": {
            "show": true,
            "position": "inside",
            "formatterTemplate": "{value:thousands}",
            "color": "$theme.paletteText.0"
          }
        },
        {
          "type": "bar",
          "name": "Profit",
          "stack": "balance",
          "data": "$slot.m1.values",
          "stackStrategy": "samesign",
          "labelLayout": {
            "hideOverlap": true
          },
          "label": {
            "show": true,
            "position": "inside",
            "formatterTemplate": "{value:thousands}",
            "color": "$theme.paletteText.1"
          }
        },
        {
          "type": "bar",
          "name": "Returns cost (outflow)",
          "stack": "balance",
          "data": "$slot.m2.values",
          "stackStrategy": "samesign",
          "labelLayout": {
            "hideOverlap": true
          },
          "label": {
            "show": false,
            "position": "inside",
            "formatterTemplate": "{value:thousands}",
            "color": "$theme.paletteText.2"
          }
        }
      ]
    }
  },
  "measures": {
    "Stress Negative Cost": "-[Total Cost]",
    "Stress Returns Cost": "-[Quantity Returned] * [Average Retail Price]"
  }
}
