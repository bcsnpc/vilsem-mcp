{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "expressiveness_sunburst",
      "name": "Category ? subcategory ? colour",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "subcategory": {
        "kind": "dimension"
      },
      "colour": {
        "kind": "dimension"
      },
      "weight": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "Category / subcategory / colour",
        "left": 12,
        "top": 8,
        "textStyle": {
          "fontSize": 16,
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "item"
      },
      "series": [
        {
          "type": "sunburst",
          "radius": [
            "8%",
            "84%"
          ],
          "center": [
            "50%",
            "56%"
          ],
          "data": "$calc.tree.children",
          "label": {
            "rotate": "radial"
          },
          "itemStyle": {
            "borderWidth": 1,
            "borderColor": "$theme.background"
          },
          "labelLayout": {
            "hideOverlap": true
          }
        }
      ],
      "backgroundColor": "$theme.background"
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory",
            "colour"
          ],
          "value": "weight"
        },
        "as": "tree"
      }
    ]
  }
}
