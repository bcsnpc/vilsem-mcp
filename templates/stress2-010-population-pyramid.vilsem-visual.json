{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_010_population-pyramid",
      "name": "10 \u00b7 Customer pyramid \u00b7 female / male by birth year",
      "description": "10 \u00b7 Customer pyramid \u00b7 female / male by birth year",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "10 \u00b7 Customer pyramid \u00b7 female / male by birth year",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1"
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1"
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Female (left)",
          "stack": "population",
          "data": "$slot.m0.values"
        },
        {
          "type": "bar",
          "name": "Male (right)",
          "stack": "population",
          "data": "$slot.m1.values"
        }
      ]
    }
  },
  "measures": {
    "Stress Female Customers": "-CALCULATE([Total Customers], 'Customer Lookup'[Gender] = \"F\")",
    "Stress Male Customers": "CALCULATE([Total Customers], 'Customer Lookup'[Gender] = \"M\")"
  }
}