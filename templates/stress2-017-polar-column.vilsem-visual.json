{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_017_polar-column",
      "name": "17 \u00b7 Country revenue \u00b7 radial columns",
      "description": "17 \u00b7 Country revenue \u00b7 radial columns",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "17 \u00b7 Country revenue \u00b7 radial columns",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "polar": {
        "center": [
          "50%",
          "55%"
        ],
        "radius": "65%"
      },
      "angleAxis": {
        "type": "category",
        "data": "$slot.date.categories",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "radiusAxis": {
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        }
      },
      "series": [
        {
          "type": "bar",
          "coordinateSystem": "polar",
          "data": "$slot.m0.values",
          "name": "Revenue"
        }
      ]
    }
  }
}
