{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_015_wrapped-bar",
      "name": "15 \u00b7 Subcategory revenue \u00b7 wrapped into columns",
      "description": "15 \u00b7 Subcategory revenue \u00b7 wrapped into columns",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "15 \u00b7 Subcategory revenue \u00b7 wrapped into columns",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "repeat": "$calc.wrapped.panels",
        "template": {
          "left": "$item.left",
          "top": "$item.top",
          "width": "$item.width",
          "height": "$item.height",
          "containLabel": true
        }
      },
      "xAxis": {
        "repeat": "$calc.wrapped.panels",
        "template": {
          "type": "value",
          "gridIndex": "$item.index",
          "splitNumber": 2,
          "axisLabel": {
            "color": "$theme.textPrimary",
            "formatterTemplate": "{value:thousands}",
            "hideOverlap": true,
            "rotate": 30,
            "fontSize": 10
          }
        }
      },
      "yAxis": {
        "repeat": "$calc.wrapped.panels",
        "template": {
          "type": "category",
          "gridIndex": "$item.index",
          "inverse": true,
          "data": "$item.categories",
          "axisLabel": {
            "color": "$theme.textPrimary",
            "width": 85,
            "overflow": "truncate"
          }
        }
      },
      "series": {
        "repeat": "$calc.wrapped.panels",
        "template": {
          "type": "bar",
          "name": "Revenue",
          "xAxisIndex": "$item.index",
          "yAxisIndex": "$item.index",
          "data": "$item.data"
        }
      }
    },
    "transforms": [
      {
        "chunk": {
          "category": "date",
          "value": "m0",
          "size": 6,
          "columns": 3
        },
        "as": "wrapped"
      }
    ]
  }
}
