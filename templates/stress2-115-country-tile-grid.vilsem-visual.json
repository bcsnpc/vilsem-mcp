{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_115_country-tile-grid",
      "name": "115 - Fixed country tile grid - revenue",
      "description": "115 - Fixed country tile grid - revenue",
      "formatVersion": 3
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "115 - Fixed country tile grid - revenue",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 100,
        "right": 100,
        "top": 90,
        "bottom": 120,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": [
          0,
          1,
          2,
          3,
          4
        ],
        "show": false
      },
      "yAxis": {
        "type": "category",
        "data": [
          0,
          1,
          2
        ],
        "show": false
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$calc.tiles.data",
          "label": {
            "show": true,
            "formatterTemplate": "{name}"
          },
          "itemStyle": {
            "borderColor": "$theme.background",
            "borderWidth": 5
          }
        }
      ],
      "visualMap": {
        "min": 0,
        "max": "$calc.tiles.max",
        "left": "center",
        "bottom": 15,
        "orient": "horizontal",
        "inRange": {
          "color": [
            "#172554",
            "#0d9488"
          ]
        },
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      }
    },
    "transforms": [
      {
        "tiles": {
          "category": "country",
          "value": "revenue",
          "positions": [
            {
              "name": "Canada",
              "x": 0,
              "y": 2
            },
            {
              "name": "United States",
              "x": 0,
              "y": 1
            },
            {
              "name": "United Kingdom",
              "x": 2,
              "y": 2
            },
            {
              "name": "France",
              "x": 2,
              "y": 1
            },
            {
              "name": "Germany",
              "x": 3,
              "y": 1
            },
            {
              "name": "Australia",
              "x": 4,
              "y": 0
            }
          ]
        },
        "as": "tiles"
      }
    ]
  }
}
