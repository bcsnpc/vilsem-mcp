{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_066_bump-rank",
      "name": "66 - Country revenue rank over months - bump chart",
      "description": "66 - Country revenue rank over months - bump chart",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "country": {
        "kind": "dimension"
      },
      "rank": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "66 - Country revenue rank over months - bump chart",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": true
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "inverse": true,
        "min": 1,
        "max": 6,
        "interval": 1
      },
      "series": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "line",
          "name": "$item.name",
          "data": "$item.data",
          "symbolSize": 6,
          "lineStyle": {
            "width": 2
          }
        }
      }
    },
    "transforms": [
      {
        "facet": {
          "by": "country",
          "category": "date",
          "value": "rank"
        },
        "as": "facets"
      }
    ]
  },
  "measures": {
    "Stress Country Revenue Rank": "RANKX(ALL('Territory Lookup'[Country]), [Total Revenue], , DESC, DENSE)"
  }
}
