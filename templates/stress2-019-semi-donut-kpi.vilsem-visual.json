{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_019_semi-donut-kpi",
      "name": "19 \u00b7 Global profit margin \u00b7 semi-circle KPI",
      "description": "19 \u00b7 Global profit margin \u00b7 semi-circle KPI",
      "formatVersion": 2
    },
    "slots": {
      "margin": {
        "kind": "measure"
      },
      "rest": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "19 \u00b7 Global profit margin \u00b7 semi-circle KPI",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item"
      },
      "series": [
        {
          "type": "pie",
          "startAngle": 180,
          "endAngle": 0,
          "radius": [
            "58%",
            "78%"
          ],
          "center": [
            "50%",
            "70%"
          ],
          "label": {
            "show": false
          },
          "data": [
            {
              "name": "Profit share",
              "value": "$slot.margin.first",
              "itemStyle": {
                "color": "#2dd4bf"
              }
            },
            {
              "name": "Cost share",
              "value": "$slot.rest.first",
              "itemStyle": {
                "color": "$theme.gridStroke"
              }
            }
          ]
        }
      ],
      "graphic": [
        {
          "type": "text",
          "left": "center",
          "top": "55%",
          "style": {
            "text": "$slot.margin.lastLabel",
            "fill": "$theme.textPrimary",
            "fontSize": 42,
            "fontFamily": "$theme.font"
          }
        },
        {
          "type": "text",
          "left": "center",
          "top": "68%",
          "style": {
            "text": "Profit margin (%)",
            "fill": "$theme.textPrimary",
            "fontSize": 16,
            "fontFamily": "$theme.font"
          }
        }
      ]
    }
  },
  "measures": {
    "Stress Margin Percent": "100 * DIVIDE([Total Profit],[Total Revenue])",
    "Stress Remaining Percent": "100 * DIVIDE([Total Cost],[Total Revenue])"
  }
}
