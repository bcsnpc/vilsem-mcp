{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_108_pareto-count",
      "name": "108 - Revenue Pareto - count of subcategories reaching 80 percent",
      "description": "108 - Revenue Pareto - count of subcategories reaching 80 percent",
      "formatVersion": 3
    },
    "slots": {
      "subcategory": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "108 - Revenue Pareto - count of subcategories reaching 80 percent",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.pareto.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": [
        {
          "type": "value",
          "axisLabel": {
            "color": "$theme.textPrimary",
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "$theme.gridStroke"
            }
          }
        },
        {
          "type": "value",
          "min": 0,
          "max": 1,
          "axisLabel": {
            "color": "$theme.textPrimary",
            "formatterTemplate": "{value:percent}"
          }
        }
      ],
      "series": [
        {
          "type": "bar",
          "name": "Revenue",
          "data": "$calc.pareto.data"
        },
        {
          "type": "line",
          "name": "Cumulative share",
          "yAxisIndex": 1,
          "data": "$calc.pareto.cumulative",
          "markLine": {
            "symbol": "none",
            "data": [
              {
                "yAxis": 0.8
              }
            ]
          }
        },
        {
          "type": "gauge",
          "center": [
            "72%",
            "20%"
          ],
          "radius": "10%",
          "min": 0,
          "max": 100,
          "pointer": {
            "show": false
          },
          "axisLine": {
            "show": false
          },
          "axisTick": {
            "show": false
          },
          "axisLabel": {
            "show": false
          },
          "splitLine": {
            "show": false
          },
          "title": {
            "show": false
          },
          "detail": {
            "fontSize": 15,
            "color": "$theme.textPrimary",
            "formatterTemplate": "{value} categories reach 80%"
          },
          "data": [
            {
              "value": "$calc.pareto.thresholdCount"
            }
          ]
        }
      ]
    },
    "transforms": [
      {
        "pareto": {
          "category": "subcategory",
          "value": "revenue",
          "threshold": 0.8
        },
        "as": "pareto"
      }
    ]
  }
}
