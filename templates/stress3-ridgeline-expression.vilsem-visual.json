{
  "version": 1,
  "specVersion": "0.7",
  "type": "custom",
  "bindings": {
    "dimensions": [
      {
        "table": "Product Categories Lookup",
        "column": "CategoryName"
      },
      {
        "table": "Product Lookup",
        "column": "ProductKey"
      },
      {
        "table": "Product Lookup",
        "column": "ProductPrice"
      }
    ],
    "measures": [
      {
        "table": "Measure Table",
        "name": "Total Revenue"
      }
    ]
  },
  "template": {
    "meta": {
      "id": "stress3-ridgeline-expression",
      "name": "ridgeline — retail price by category",
      "formatVersion": 4
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "sku": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "sold": {
        "kind": "measure"
      }
    },
    "transforms": [
      {
        "as": "outline",
        "density": {
          "by": "category",
          "field": "price",
          "layout": "ridgeline",
          "samples": 64,
          "expressionGeometry": true
        }
      }
    ],
    "template": {
      "animation": false,
      "title": {
        "text": "Ridgeline — sold SKU retail prices",
        "subtext": "One observation per sold SKU; Gaussian KDE may extend beyond the observed price range",
        "left": "center",
        "textStyle": {
          "fontSize": 18
        },
        "subtextStyle": {
          "fontSize": 11,
          "color": "#595959"
        }
      },
      "grid": {
        "left": 65,
        "right": 35,
        "top": 85,
        "bottom": 50
      },
      "tooltip": {
        "trigger": "item",
        "formatterTemplate": "{name}: retail-price kernel density (one observation per sold SKU)"
      },
      "xAxis": {
        "type": "value",
        "min": "$calc.outline.geometryXMin",
        "max": "$calc.outline.geometryXMax",
        "name": "Retail price (USD)",
        "axisLabel": {
          "show": true,
          "formatterTemplate": "{value:thousands}"
        },
        "nameLocation": "middle",
        "nameGap": 32
      },
      "yAxis": {
        "type": "value",
        "min": "$calc.outline.geometryYMin",
        "max": "$calc.outline.geometryYMax",
        "name": "",
        "axisLabel": {
          "show": false
        }
      },
      "series": [
        {
          "type": "custom",
          "name": "Retail-price density",
          "dimensions": [
            "left",
            "top",
            "width",
            "height",
            "group",
            {
              "name": "outline",
              "type": "ordinal"
            }
          ],
          "encode": {
            "x": [
              0,
              2
            ],
            "y": [
              1,
              3
            ],
            "tooltip": []
          },
          "data": "$calc.outline.geometryData",
          "renderItem": {
            "language": "vilsem-expression",
            "version": 1,
            "root": {
              "type": "path",
              "shape": {
                "pathData": {
                  "op": "value",
                  "args": [
                    5
                  ]
                }
              },
              "x": {
                "op": "at",
                "args": [
                  {
                    "op": "coord",
                    "args": [
                      [
                        {
                          "op": "value",
                          "args": [
                            0
                          ]
                        },
                        {
                          "op": "value",
                          "args": [
                            1
                          ]
                        }
                      ]
                    ]
                  },
                  0
                ]
              },
              "y": {
                "op": "at",
                "args": [
                  {
                    "op": "coord",
                    "args": [
                      [
                        {
                          "op": "value",
                          "args": [
                            0
                          ]
                        },
                        {
                          "op": "value",
                          "args": [
                            1
                          ]
                        }
                      ]
                    ]
                  },
                  1
                ]
              },
              "scaleX": {
                "op": "abs",
                "args": [
                  {
                    "op": "at",
                    "args": [
                      {
                        "op": "size",
                        "args": [
                          [
                            {
                              "op": "value",
                              "args": [
                                2
                              ]
                            },
                            {
                              "op": "value",
                              "args": [
                                3
                              ]
                            }
                          ]
                        ]
                      },
                      0
                    ]
                  }
                ]
              },
              "scaleY": {
                "op": "abs",
                "args": [
                  {
                    "op": "at",
                    "args": [
                      {
                        "op": "size",
                        "args": [
                          [
                            {
                              "op": "value",
                              "args": [
                                2
                              ]
                            },
                            {
                              "op": "value",
                              "args": [
                                3
                              ]
                            }
                          ]
                        ]
                      },
                      1
                    ]
                  }
                ]
              },
              "style": {
                "fill": "none",
                "stroke": "#118DFF",
                "strokeNoScale": true,
                "opacity": 0.65,
                "lineWidth": 1.5
              }
            }
          }
        },
        {
          "type": "custom",
          "name": "Category labels",
          "clip": false,
          "dimensions": [
            "x",
            "y",
            {
              "name": "category",
              "type": "ordinal"
            }
          ],
          "encode": {
            "x": 0,
            "y": 1,
            "tooltip": []
          },
          "data": {
            "repeat": "$calc.outline.panels",
            "template": {
              "name": "$item.name",
              "value": [
                "$calc.outline.geometryXMin",
                "$item.index",
                "$item.name"
              ],
              "rowIndexes": "$item.rowIndexes"
            }
          },
          "renderItem": {
            "language": "vilsem-expression",
            "version": 1,
            "root": {
              "type": "text",
              "role": "label",
              "style": {
                "text": {
                  "op": "value",
                  "args": [
                    2
                  ]
                },
                "x": {
                  "op": "add",
                  "args": [
                    {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              {
                                "op": "value",
                                "args": [
                                  0
                                ]
                              },
                              {
                                "op": "value",
                                "args": [
                                  1
                                ]
                              }
                            ]
                          ]
                        },
                        0
                      ]
                    },
                    8
                  ]
                },
                "y": {
                  "op": "add",
                  "args": [
                    {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              {
                                "op": "value",
                                "args": [
                                  0
                                ]
                              },
                              {
                                "op": "value",
                                "args": [
                                  1
                                ]
                              }
                            ]
                          ]
                        },
                        1
                      ]
                    },
                    -12
                  ]
                },
                "align": "left",
                "width": 140,
                "overflow": "truncate",
                "fontSize": 12,
                "fill": "$theme.textPrimary"
              }
            }
          }
        }
      ]
    }
  }
}
