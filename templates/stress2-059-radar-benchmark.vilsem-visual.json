{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_059_radar-benchmark",
      "name": "59 - Country revenue and model revenue target - radar",
      "description": "59 - Country revenue and model revenue target - radar",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "actual": {
        "kind": "measure"
      },
      "target": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "59 - Country revenue and model revenue target - radar",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "show": true,
        "top": 45,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "radar": {
        "center": [
          "50%",
          "57%"
        ],
        "radius": "59%",
        "indicator": {
          "repeat": "$slot.country.categories",
          "template": {
            "name": "$item"
          }
        },
        "axisName": {
          "color": "$theme.textPrimary"
        },
        "splitArea": {
          "areaStyle": {
            "color": [
              "$theme.background",
              "$theme.gridStroke"
            ],
            "opacity": 0.12
          }
        }
      },
      "series": [
        {
          "type": "radar",
          "data": {
            "concat": [
              {
                "repeat": "$calc.actualPanel.panels",
                "template": {
                  "name": "Revenue",
                  "value": "$item.values",
                  "rowIndexes": "$item.rowIndexes"
                }
              },
              {
                "repeat": "$calc.targetPanel.panels",
                "template": {
                  "name": "Target",
                  "value": "$item.values",
                  "rowIndexes": "$item.rowIndexes"
                }
              }
            ]
          },
          "areaStyle": {
            "opacity": 0.1
          }
        }
      ]
    },
    "transforms": [
      {
        "calculate": "0",
        "as": "constant"
      },
      {
        "facet": {
          "by": "constant",
          "category": "country",
          "value": "actual"
        },
        "as": "actualPanel"
      },
      {
        "facet": {
          "by": "constant",
          "category": "country",
          "value": "target"
        },
        "as": "targetPanel"
      }
    ]
  }
}
