{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_030_pareto",
      "name": "30 \u00b7 Subcategory revenue Pareto \u00b7 cumulative share",
      "description": "30 \u00b7 Subcategory revenue Pareto \u00b7 cumulative share",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "30 \u00b7 Subcategory revenue Pareto \u00b7 cumulative share",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": [
        {
          "type": "value",
          "axisLabel": {
            "color": "#cbd5e1",
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "#263244"
            }
          }
        },
        {
          "type": "value",
          "min": 0,
          "max": 1,
          "axisLabel": {
            "color": "#f59e0b",
            "formatterTemplate": "{value:percent}"
          },
          "splitLine": {
            "show": false
          }
        }
      ],
      "series": [
        {
          "type": "bar",
          "name": "Revenue",
          "data": "$slot.m0.values"
        },
        {
          "type": "line",
          "name": "Cumulative share",
          "yAxisIndex": 1,
          "data": "$calc.cumulative.values",
          "markLine": {
            "symbol": "none",
            "data": [
              {
                "yAxis": 0.8
              }
            ],
            "label": {
              "color": "#f8fafc",
              "formatterTemplate": "{value:percent}"
            }
          }
        }
      ]
    },
    "transforms": [
      {
        "window": {
          "op": "percentOfTotal",
          "field": "m0"
        },
        "as": "share"
      },
      {
        "window": {
          "op": "sum",
          "field": "share"
        },
        "as": "cumulative"
      }
    ]
  }
}