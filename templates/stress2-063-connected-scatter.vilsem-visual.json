{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_063_connected-scatter",
      "name": "63 - Revenue versus profit - connected in month order",
      "description": "63 - Revenue versus profit - connected in month order",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      },
      "profit": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "63 - Revenue versus profit - connected in month order",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{name} | Revenue {value.0:thousands} | Profit {value.1:thousands}"
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "data": "$calc.path.data",
          "symbolSize": 6,
          "lineStyle": {
            "width": 2
          },
          "showSymbol": true
        }
      ]
    },
    "transforms": [
      {
        "points": {
          "fields": [
            "revenue",
            "profit"
          ],
          "numeric": [
            "revenue",
            "profit"
          ],
          "name": "date"
        },
        "as": "path"
      }
    ]
  }
}
