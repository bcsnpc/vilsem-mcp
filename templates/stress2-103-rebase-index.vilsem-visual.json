{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_103_rebase-index",
      "name": "103 - Country monthly revenue rebased to first nonzero month = 100",
      "description": "103 - Country monthly revenue rebased to first nonzero month = 100",
      "formatVersion": 3
    },
    "slots": {
      "month": {
        "kind": "time"
      },
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "103 - Country monthly revenue rebased to first nonzero month = 100",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.panels.panels.0.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "name": "Index"
      },
      "series": {
        "repeat": "$calc.panels.panels",
        "template": {
          "type": "line",
          "name": "$item.name",
          "data": "$item.data",
          "showSymbol": false
        }
      }
    },
    "transforms": [
      {
        "rebase": {
          "field": "revenue",
          "partitionBy": "country",
          "orderBy": "month",
          "base": 100
        },
        "as": "indexed"
      },
      {
        "facet": {
          "by": "country",
          "category": "month",
          "value": "indexed",
          "maxPanels": 6
        },
        "as": "panels"
      }
    ]
  }
}
