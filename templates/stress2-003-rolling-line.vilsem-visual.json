{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_003_rolling-line",
      "name": "03 \u00b7 Daily revenue and 7-day calendar mean",
      "description": "03 \u00b7 Daily revenue and 7-day calendar mean",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "03 \u00b7 Daily revenue and 7-day calendar mean",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "Daily revenue",
          "data": "$slot.m0.values",
          "showSymbol": false,
          "lineStyle": {
            "width": 1
          }
        },
        {
          "type": "line",
          "name": "7-day rolling mean",
          "data": "$slot.m1.values",
          "showSymbol": false,
          "lineStyle": {
            "width": 3
          }
        }
      ]
    }
  },
  "measures": {
    "Stress Rolling Revenue": "DIVIDE(CALCULATE([Total Revenue], DATESINPERIOD('Calendar Lookup'[Date], MAX('Calendar Lookup'[Date]), -7, DAY)), 7)"
  }
}
