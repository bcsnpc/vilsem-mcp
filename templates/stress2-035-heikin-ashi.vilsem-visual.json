{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_035_heikin-ashi",
      "name": "35 \u00b7 Sales-line revenue Heikin-Ashi \u00b7 daily volume",
      "description": "35 \u00b7 Sales-line revenue Heikin-Ashi \u00b7 daily volume",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      },
      "m3": {
        "kind": "measure"
      },
      "m4": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "35 \u00b7 Sales-line revenue Heikin-Ashi \u00b7 daily volume",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": [
        {
          "left": 75,
          "right": 40,
          "top": 90,
          "height": "52%",
          "containLabel": true
        },
        {
          "left": 75,
          "right": 40,
          "top": "75%",
          "height": "14%",
          "containLabel": true
        }
      ],
      "xAxis": [
        {
          "type": "category",
          "data": "$slot.date.values",
          "axisLabel": {
            "color": "#cbd5e1",
            "rotate": 35,
            "hideOverlap": true,
            "formatterTemplate": "{value:date}"
          },
          "axisLine": {
            "lineStyle": {
              "color": "#64748b"
            }
          }
        },
        {
          "type": "category",
          "data": "$slot.date.values",
          "gridIndex": 1,
          "axisLabel": {
            "show": false
          }
        }
      ],
      "yAxis": [
        {
          "type": "value",
          "axisLabel": {
            "color": "#cbd5e1",
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "#263244"
            }
          }
        },
        {
          "type": "value",
          "gridIndex": 1,
          "axisLabel": {
            "color": "#cbd5e1"
          }
        }
      ],
      "series": [
        {
          "type": "candlestick",
          "name": "Derived OHLC",
          "data": "$calc.ohlc.data",
          "itemStyle": {
            "color": "#2dd4bf",
            "color0": "#f87171",
            "borderColor": "#2dd4bf",
            "borderColor0": "#f87171"
          }
        },
        {
          "type": "bar",
          "name": "Sales lines",
          "xAxisIndex": 1,
          "yAxisIndex": 1,
          "data": "$slot.m4.values"
        }
      ],
      "dataZoom": [
        {
          "type": "slider",
          "xAxisIndex": [
            0,
            1
          ],
          "start": 80,
          "end": 100,
          "filterMode": "none",
          "bottom": 6,
          "height": 18,
          "textStyle": {
            "color": "#cbd5e1"
          }
        }
      ]
    },
    "transforms": [
      {
        "heikinAshi": {
          "open": "m0",
          "close": "m1",
          "low": "m2",
          "high": "m3"
        },
        "as": "ohlc"
      }
    ]
  },
  "measures": {
    "Stress Open Revenue": "MINX(TOPN(1,'Sales Data','Sales Data'[OrderNumber],ASC,'Sales Data'[OrderLineItem],ASC),'Sales Data'[Revenue])",
    "Stress Close Revenue": "MAXX(TOPN(1,'Sales Data','Sales Data'[OrderNumber],DESC,'Sales Data'[OrderLineItem],DESC),'Sales Data'[Revenue])",
    "Stress Low Revenue": "MIN('Sales Data'[Revenue])",
    "Stress High Revenue": "MAX('Sales Data'[Revenue])",
    "Stress Line Volume": "COUNTROWS('Sales Data')"
  }
}