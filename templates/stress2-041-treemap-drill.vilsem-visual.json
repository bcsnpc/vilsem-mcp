{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_041_treemap-drill",
      "name": "41 - Revenue treemap - click a category, use breadcrumb to return",
      "description": "41 - Revenue treemap - click a category, use breadcrumb to return",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "subcategory": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "41 - Revenue treemap - click a category, use breadcrumb to return",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "series": [
        {
          "type": "treemap",
          "name": "Products",
          "itemStyle": {
            "borderColor": "$theme.background",
            "borderWidth": 3,
            "gapWidth": 2
          },
          "top": 80,
          "bottom": 70,
          "left": 25,
          "right": 25,
          "data": "$calc.tree.children",
          "leafDepth": 1,
          "nodeClick": "zoomToNode",
          "roam": false,
          "label": {
            "show": true
          },
          "upperLabel": {
            "show": true,
            "height": 24,
            "color": "$theme.textPrimary"
          },
          "breadcrumb": {
            "show": true,
            "bottom": 15,
            "itemStyle": {
              "color": "$theme.gridStroke",
              "textStyle": {
                "color": "$theme.textPrimary"
              }
            }
          }
        }
      ]
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory"
          ],
          "value": "revenue"
        },
        "as": "tree"
      }
    ]
  }
}
