{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_098_hexbin-price-cost",
      "name": "98 - Sold product retail price versus cost - hexagonal counts",
      "description": "98 - Sold product retail price versus cost - hexagonal counts",
      "formatVersion": 3
    },
    "slots": {
      "product": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "cost": {
        "kind": "dimension"
      },
      "sold": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "98 - Sold product retail price versus cost - hexagonal counts",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 120,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "name": "Retail price",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "nameLocation": "middle",
        "nameGap": 45
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "name": "Cost"
      },
      "series": [
        {
          "type": "scatter",
          "data": "$calc.binned.data",
          "symbol": "path://M0,-10L8.66,-5L8.66,5L0,10L-8.66,5L-8.66,-5Z",
          "symbolSize": 16
        }
      ],
      "visualMap": {
        "type": "continuous",
        "dimension": 2,
        "min": 0,
        "max": "$calc.binned.max",
        "orient": "horizontal",
        "bottom": 15,
        "left": "center",
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "inRange": {
          "color": [
            "#172554",
            "#14b8a6",
            "#fef08a"
          ]
        }
      }
    },
    "transforms": [
      {
        "hexbin": {
          "x": "price",
          "y": "cost",
          "bins": 24
        },
        "as": "binned"
      }
    ]
  }
