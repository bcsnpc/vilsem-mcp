{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_046_radial-tree",
      "name": "46 - Category to subcategory revenue - radial tree",
