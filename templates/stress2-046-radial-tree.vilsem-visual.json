              "fontSize": 10
            }
          },
          "lineStyle": {
            "color": "#64748b"
          },
          "itemStyle": {
            "color": "#2dd4bf"
          }
        }
      ]
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory"
          ],
          "value": "revenue"
        },
        "as": "tree"
