      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "46 - Category to subcategory revenue - radial tree",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "series": [
        {
          "type": "tree",
          "data": [
            {
              "name": "Products",
              "children": "$calc.tree.children"
            }
          ],
          "top": 135,
          "bottom": 115,
          "left": 140,
          "right": 180,
          "layout": "radial",
          "orient": "LR",
          "edgeShape": "curve",
          "initialTreeDepth": -1,
          "expandAndCollapse": true,
