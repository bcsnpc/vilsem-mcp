{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_043_icicle-partition",
      "name": "43 - Revenue hierarchy - rectangular icicle partition",
      "description": "43 - Revenue hierarchy - rectangular icicle partition",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "subcategory": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "43 - Revenue hierarchy - rectangular icicle partition",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 55,
        "right": 30,
        "top": 100,
        "bottom": 90,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "min": 0,
        "max": 1,
        "axisLabel": {
          "formatterTemplate": "{value:percent}",
          "color": "$theme.textPrimary"
        }
      },
      "yAxis": {
        "type": "category",
        "inverse": true,
        "data": [
          "Category",
          "Subcategory"
        ],
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "series": {
        "concat": [
          {
            "repeat": "$calc.tree.nodes",
            "template": {
              "type": "bar",
              "name": "Offset",
              "stack": "$item.id",
              "data": "$item.base",
              "barGap": "-100%",
              "barWidth": "85%",
              "itemStyle": {
                "opacity": 0
              },
              "silent": true
            }
          },
          {
            "repeat": "$calc.tree.nodes",
            "template": {
              "type": "bar",
              "name": "$item.name",
              "stack": "$item.id",
              "data": "$item.data",
              "barGap": "-100%",
              "barWidth": "85%",
              "label": {
                "show": true,
                "position": "inside",
                "formatterTemplate": "{seriesName}",
                "fontSize": 11,
                "width": 90,
                "overflow": "truncate"
              },
              "labelLayout": {
                "hideOverlap": true
              },
              "itemStyle": {
                "borderColor": "$theme.background",
                "borderWidth": 1
              }
            }
          }
        ]
      }
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory"
          ],
          "value": "revenue",
          "layout": "partition"
        },
        "as": "tree"
      }
    ]
  }
}
