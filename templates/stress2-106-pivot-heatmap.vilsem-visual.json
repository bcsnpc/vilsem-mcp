{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_106_pivot-heatmap",
      "name": "106 - Long-format country/category revenue pivot",
      "description": "106 - Long-format country/category revenue pivot",
      "formatVersion": 3
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "106 - Long-format country/category revenue pivot",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 150,
        "right": 40,
        "top": 90,
        "bottom": 120,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.pivot.columns",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$calc.pivot.rows",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$calc.pivot.data",
          "label": {
            "show": true,
            "formatterTemplate": "{value.2:thousands}"
          }
        }
      ],
      "visualMap": {
        "min": 0,
        "max": "$calc.pivot.max",
        "bottom": 10,
        "orient": "horizontal",
        "left": "center",
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "inRange": {
          "color": [
            "#172554",
            "#14b8a6"
          ]
        }
      }
    },
    "transforms": [
      {
        "pivot": {
          "row": "country",
          "column": "category",
          "value": "revenue"
        },
        "as": "pivot"
      }
    ]
  }
}
