{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_079_control-chart",
      "name": "79 - Daily revenue control chart - visual-scoped mean +/- 3 sigma",
      "description": "79 - Daily revenue control chart - visual-scoped mean +/- 3 sigma",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      },
      "mean": {
        "kind": "measure"
      },
      "sigma": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "79 - Daily revenue control chart - visual-scoped mean +/- 3 sigma",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "#263244"
          }
        },
        "min": "$calc.lowDomain.min",
        "max": "$calc.highDomain.max"
      },
      "series": [
        {
          "type": "line",
          "name": "Revenue",
          "data": "$slot.revenue.values",
          "showSymbol": false,
          "markLine": {
            "symbol": "none",
            "label": {
              "position": "insideEndTop",
              "formatterTemplate": "{name}",
              "color": "#f59e0b"
            },
            "data": [
              {
                "yAxis": "$slot.mean.first",
                "name": "Mean"
              },
              {
                "yAxis": "$calc.upper.first",
                "name": "+3 sigma"
              },
              {
                "yAxis": "$calc.lower.first",
                "name": "-3 sigma"
              }
            ]
          }
        }
      ]
    },
    "transforms": [
      {
        "calculate": "mean+3*sigma",
        "as": "upper"
      },
      {
        "calculate": "mean-3*sigma",
        "as": "lower"
      },
      {
        "calculate": "max(revenue,mean+3*sigma)",
        "as": "bound"
      },
      {
        "stat": {
          "field": "bound",
          "op": "max"
        },
        "as": "globalMax"
      },
      {
        "calculate": "lower-max(1,globalMax-lower)*0.08",
        "as": "lowDomain"
      },
      {
        "calculate": "globalMax+max(1,globalMax-lower)*0.08",
        "as": "highDomain"
      }
    ]
  },
  "measures": {
    "Stress Global Daily Mean": "AVERAGEX(ALL('Calendar Lookup'[Date]), [Total Revenue])",
    "Stress Global Daily Sigma": "STDEVX.P(ALL('Calendar Lookup'[Date]), [Total Revenue])"
  }
}