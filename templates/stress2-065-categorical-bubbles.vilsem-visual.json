{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_065_categorical-bubbles",
      "name": "65 - Revenue / profit bubbles - country legend, size by quantity",
      "description": "65 - Revenue / profit bubbles - country legend, size by quantity",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      },
      "profit": {
        "kind": "measure"
      },
      "quantity": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "65 - Revenue / profit bubbles - country legend, size by quantity",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "show": true,
        "top": 45,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{name}: revenue {value.0:thousands}, profit {value.1:thousands}, units {value.2:thousands}"
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "visualMap": {
        "show": false,
        "dimension": 2,
        "min": "$slot.quantity.min",
        "max": "$slot.quantity.max",
        "inRange": {
          "symbolSize": [
            12,
            65
          ]
        }
      },
      "series": {
        "repeat": "$calc.xy.data",
        "template": {
          "type": "scatter",
          "name": "$item.name",
          "data": [
            "$item"
          ],
          "labelLayout": {
            "hideOverlap": true
          },
          "label": {
            "show": true,
            "position": "top",
            "formatterTemplate": "{name}",
            "color": "$theme.textPrimary"
          }
        }
      }
    },
    "transforms": [
      {
        "points": {
          "fields": [
            "revenue",
            "profit",
            "quantity"
          ],
          "numeric": [
            "revenue",
            "profit",
            "quantity"
          ],
          "name": "country"
        },
        "as": "xy"
      }
    ]
  }
}
