{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_002_spline-gradient",
      "name": "02 \u00b7 Revenue spline with gradient",
      "description": "02 \u00b7 Revenue spline with gradient",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "m0": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "02 \u00b7 Revenue spline with gradient",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "Revenue",
          "smooth": true,
          "showSymbol": false,
          "data": "$slot.m0.values",
          "areaStyle": {
            "color": {
              "type": "linear",
              "x": 0,
              "y": 0,
              "x2": 0,
              "y2": 1,
              "colorStops": [
                {
                  "offset": 0,
                  "color": "#14b8a6cc"
                },
                {
                  "offset": 1,
                  "color": "#14b8a600"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
