      "description": "26 \u00b7 Global profit margin \u00b7 linear threshold gauge",
      "formatVersion": 2
    },
    "slots": {
      "margin": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
