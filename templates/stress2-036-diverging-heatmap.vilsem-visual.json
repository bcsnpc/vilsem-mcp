{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_036_diverging-heatmap",
      "name": "36 \u00b7 Country/category profit vs target \u00b7 zero-centred heatmap",
      "description": "36 \u00b7 Country/category profit vs target \u00b7 zero-centred heatmap",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "variance": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "36 \u00b7 Country/category profit vs target \u00b7 zero-centred heatmap",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.country.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 25
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.category.categories",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "visualMap": {
        "type": "continuous",
        "min": "$calc.floor.min",
        "max": "$calc.ceiling.max",
        "dimension": 2,
        "calculable": true,
        "orient": "horizontal",
        "left": "center",
        "bottom": 10,
        "inRange": {
          "color": [
            "#ef4444",
            "$theme.gridStroke",
            "#2dd4bf"
          ]
        },
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$slot.variance.matrix",
          "label": {
            "show": true,
            "formatterTemplate": "{value:thousands}"
          }
        }
      ]
    },
    "transforms": [
      {
        "stat": {
          "field": "variance",
          "op": "max"
        },
        "as": "maxv"
      },
      {
        "stat": {
          "field": "variance",
          "op": "min"
        },
        "as": "minv"
      },
      {
        "calculate": "max(abs(maxv),abs(minv))",
        "as": "ceiling"
      },
      {
        "calculate": "-ceiling",
        "as": "floor"
      }
    ]
  },
  "measures": {
    "Stress Profit Variance": "[Total Profit] - [Profit Target]"
  }
}
