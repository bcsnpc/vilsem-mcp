{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_039_country-lasagna",
      "name": "39 - Country revenue over months - lasagna plot",
      "description": "39 - Country revenue over months - lasagna plot",
      "formatVersion": 2
    },
    "slots": {
      "month": {
        "kind": "time"
      },
      "country": {
        "kind": "dimension"
      },
      "value": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "39 - Country revenue over months - lasagna plot",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.month.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.country.categories",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "visualMap": {
        "min": "$slot.value.min",
        "max": "$slot.value.max",
        "left": "center",
        "bottom": 10,
        "orient": "horizontal",
        "inRange": {
          "color": [
            "#172554",
            "#2dd4bf"
          ]
        },
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$slot.value.matrix"
        }
      ]
    }
  }
}
