{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_100_parameter-top-other",
      "name": "100 - Top N subcategory revenue with Other - N parameter",
      "description": "100 - Top N subcategory revenue with Other - N parameter",
      "formatVersion": 3
    },
    "slots": {
      "subcategory": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [
      {
        "name": "topN",
        "type": "number",
        "default": 5,
        "min": 1,
        "max": 15
      }
    ],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "100 - Top N subcategory revenue with Other - N parameter",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "series": [
        {
          "type": "pie",
          "radius": [
            "35%",
            "65%"
          ],
          "center": [
            "50%",
            "52%"
          ],
          "data": "$calc.ranked.pieData",
          "label": {
            "show": true,
            "color": "#cbd5e1",
            "formatterTemplate": "{name}"
          },
          "labelLayout": {
            "hideOverlap": true
          }
        }
      ]
    },
    "transforms": [
      {
        "top": {
          "category": "subcategory",
          "value": "revenue",
          "countParam": "topN"
        },
        "as": "ranked"
      }
    ]
  }
}