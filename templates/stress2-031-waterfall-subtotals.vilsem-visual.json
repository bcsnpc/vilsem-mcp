{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_031_waterfall-subtotals",
      "name": "31 \u00b7 Country/category profit waterfall \u00b7 country subtotals",
      "description": "31 \u00b7 Country/category profit waterfall \u00b7 country subtotals",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "profit": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "31 \u00b7 Country/category profit waterfall \u00b7 country subtotals",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.steps.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Offset",
          "stack": "steps",
          "stackStrategy": "all",
          "data": "$calc.steps.base",
          "itemStyle": {
            "opacity": 0
          },
          "silent": true
        },
        {
          "type": "bar",
          "name": "Increase",
          "stack": "steps",
          "stackStrategy": "all",
          "data": "$calc.steps.positive",
          "itemStyle": {
            "color": "#2dd4bf"
          }
        },
        {
          "type": "bar",
          "name": "Decrease",
          "stack": "steps",
          "stackStrategy": "all",
          "data": "$calc.steps.negative",
          "itemStyle": {
            "color": "#f87171"
          }
        },
        {
          "type": "bar",
          "name": "Subtotal",
          "stack": "steps",
          "stackStrategy": "all",
          "data": "$calc.steps.totals",
          "itemStyle": {
            "color": "#60a5fa"
          }
        }
      ]
    },
    "transforms": [
      {
        "waterfall": {
          "category": "country",
          "detail": "category",
          "value": "profit",
          "subtotals": true
        },
        "as": "steps"
      }
    ]
  }
}
