{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_083_bar-shared-axis",
      "name": "83 - Country revenue small multiples - shared scale",
      "description": "83 - Country revenue small multiples - shared scale",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "category": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "83 - Country revenue small multiples - shared scale",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": [
        {
          "left": "4.0%",
          "top": "21.0%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        },
        {
          "left": "34.66666666666667%",
          "top": "21.0%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        },
        {
          "left": "65.33333333333334%",
          "top": "21.0%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        },
        {
          "left": "4.0%",
          "top": "58.5%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        },
        {
          "left": "34.66666666666667%",
          "top": "58.5%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        },
        {
          "left": "65.33333333333334%",
          "top": "58.5%",
          "width": "27.666666666666668%",
          "height": "25.5%",
          "containLabel": true
        }
      ],
      "xAxis": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "category",
          "gridIndex": "$item.index",
          "data": "$item.categories",
          "axisLabel": {
            "color": "$theme.textPrimary",
            "fontSize": 9,
            "hideOverlap": true,
            "interval": 0
          }
        }
      },
      "yAxis": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "value",
          "gridIndex": "$item.index",
          "splitNumber": 3,
          "max": "$calc.facets.max",
          "axisLabel": {
            "showMaxLabel": false,
            "color": "$theme.textPrimary",
            "fontSize": 8,
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "$theme.gridStroke"
            }
          }
        }
      },
      "series": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "bar",
          "name": "$item.name",
          "xAxisIndex": "$item.index",
          "yAxisIndex": "$item.index",
          "data": "$item.data",
          "showSymbol": false
        }
      },
      "graphic": {
        "repeat": "$calc.facets.panels",
        "template": {
          "type": "text",
          "left": "$item.left",
          "top": "$item.top",
          "style": {
            "text": "$item.name",
            "fill": "$theme.textPrimary",
            "fontSize": 11
          }
        }
      }
    },
    "transforms": [
      {
        "facet": {
          "by": "country",
          "category": "category",
          "value": "revenue",
          "columns": 3,
          "maxPanels": 6
        },
        "as": "facets"
      }
    ]
  }
}
