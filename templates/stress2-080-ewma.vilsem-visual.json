{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_080_ewma",
      "name": "80 - Monthly revenue EWMA - alpha 0.3",
      "description": "80 - Monthly revenue EWMA - alpha 0.3",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "80 - Monthly revenue EWMA - alpha 0.3",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "name": "Revenue",
          "data": "$slot.revenue.values",
          "showSymbol": false
        },
        {
          "type": "line",
          "name": "EWMA 0.3",
          "data": "$calc.average.values",
          "showSymbol": false
        }
      ]
    },
    "transforms": [
      {
        "window": {
          "field": "revenue",
          "op": "ewma",
          "alpha": 0.3,
          "orderBy": "date"
        },
        "as": "average"
      }
    ]
  }
}
