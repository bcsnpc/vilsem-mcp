{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_105_cohort-retention",
      "name": "105 - Customer first-purchase cohort retention by month offset",
      "description": "105 - Customer first-purchase cohort retention by month offset",
      "formatVersion": 3
    },
    "slots": {
      "month": {
        "kind": "time"
      },
      "customer": {
        "kind": "dimension"
      },
      "activity": {
        "kind": "measure"
      },
      "firstPurchase": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "105 - Customer first-purchase cohort retention by month offset",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        },
        "subtext": "50 real customers (keys11000-11049); first purchase uses full model history",
        "subtextStyle": {
          "color": "$theme.textMuted",
          "fontSize": 10
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 130,
        "right": 40,
        "top": 90,
        "bottom": 120,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$calc.retention.periods",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        },
        "name": "Months since first purchase",
        "nameLocation": "middle",
        "nameGap": 45
      },
      "yAxis": {
        "type": "category",
        "data": "$calc.retention.cohorts",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$calc.retention.data"
        }
      ],
      "visualMap": {
        "min": 0,
        "max": 1,
        "bottom": 10,
        "orient": "horizontal",
        "left": "center",
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "inRange": {
          "color": [
            "#172554",
            "#14b8a6",
            "#fef08a"
          ]
        }
      }
    },
    "transforms": [
      {
        "cohort": {
          "date": "month",
          "entity": "customer",
          "value": "activity",
          "firstDay": "firstPurchase",
          "maxPeriods": 36
        },
        "as": "retention"
      }
    ]
  },
  "measures": {
    "Stress First Purchase Day": "VAR acquisitionDate=CALCULATE(MIN('Sales Data'[OrderDate]), REMOVEFILTERS('Calendar Lookup')) RETURN IF(NOT ISBLANK([Stress Cohort Orders]) && NOT ISBLANK(acquisitionDate), DATEDIFF(DATE(1970,1,1), acquisitionDate, DAY))",
    "Stress Cohort Orders": "VAR cohortCustomer=MAX('Customer Lookup'[CustomerKey]) RETURN IF(cohortCustomer>=11000 && cohortCustomer<11050, [Total Orders], BLANK())"
  }
}
