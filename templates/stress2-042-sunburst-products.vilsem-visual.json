{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_042_sunburst-products",
      "name": "42 - Category / subcategory / product revenue - sunburst",
      "description": "42 - Category / subcategory / product revenue - sunburst",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "subcategory": {
        "kind": "dimension"
      },
      "product": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "42 - Category / subcategory / product revenue - sunburst",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "series": [
        {
          "type": "sunburst",
          "center": [
            "50%",
            "54%"
          ],
          "radius": [
            "8%",
            "66%"
          ],
          "data": "$calc.tree.children",
          "nodeClick": "rootToNode",
          "label": {
            "show": true,
            "rotate": "radial",
            "fontSize": 10,
            "width": 60,
            "overflow": "truncate",
            "minAngle": 9
          },
          "itemStyle": {
            "borderColor": "$theme.background",
            "borderWidth": 2
          }
        }
      ]
    },
    "transforms": [
      {
        "hierarchy": {
          "levels": [
            "category",
            "subcategory",
            "product"
          ],
          "value": "revenue"
        },
        "as": "tree"
      }
    ]
  }
}
