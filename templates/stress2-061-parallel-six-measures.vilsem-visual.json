{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_061_parallel-six-measures",
      "name": "61 - Country comparison across six real measures - parallel coordinates",
      "description": "61 - Country comparison across six real measures - parallel coordinates",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      },
      "m2": {
        "kind": "measure"
      },
      "m3": {
        "kind": "measure"
      },
      "m4": {
        "kind": "measure"
      },
      "m5": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "61 - Country comparison across six real measures - parallel coordinates",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{name} | Revenue {value.0:thousands} | Profit {value.1:thousands} | Quantity {value.2:thousands} | Orders {value.3:thousands} | Customers {value.4:thousands} | Avg price {value.5:thousands}"
      },
      "parallel": {
        "left": 95,
        "right": 90,
        "top": 110,
        "bottom": 95,
        "parallelAxisDefault": {
          "type": "value",
          "nameTextStyle": {
            "color": "$theme.textPrimary",
            "fontSize": 10
          },
          "axisLabel": {
            "color": "$theme.textPrimary",
            "formatterTemplate": "{value:thousands}"
          }
        }
      },
      "parallelAxis": [
        {
          "dim": 0,
          "name": "Revenue"
        },
        {
          "dim": 1,
          "name": "Profit"
        },
        {
          "dim": 2,
          "name": "Quantity Sold"
        },
        {
          "dim": 3,
          "name": "Orders"
        },
        {
          "dim": 4,
          "name": "Customers"
        },
        {
          "dim": 5,
          "name": "Average Retail Price"
        }
      ],
      "series": [
        {
          "type": "parallel",
          "data": "$calc.lines.data",
          "lineStyle": {
            "width": 2,
            "opacity": 0.7
          }
        }
      ]
    },
    "transforms": [
      {
        "points": {
          "fields": [
            "m0",
            "m1",
            "m2",
            "m3",
            "m4",
            "m5"
          ],
          "numeric": [
            "m0",
            "m1",
            "m2",
            "m3",
            "m4",
            "m5"
          ],
          "name": "country"
        },
        "as": "lines"
      }
    ]
  }
}
