{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_057_adjacency-matrix",
      "name": "57 - Top ten product / model revenue - adjacency matrix",
      "description": "57 - Top ten product / model revenue - adjacency matrix",
      "formatVersion": 2
    },
    "slots": {
      "product": {
        "kind": "dimension"
      },
      "model": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "57 - Top ten product / model revenue - adjacency matrix",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "Revenue {value.2:thousands}"
      },
      "grid": {
        "left": 160,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.product.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "rotate": 35,
          "hideOverlap": true,
          "fontSize": 9
        },
        "axisLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.model.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "fontSize": 10,
          "width": 130,
          "overflow": "truncate"
        }
      },
      "visualMap": {
        "min": "$slot.revenue.min",
        "max": "$slot.revenue.max",
        "orient": "horizontal",
        "left": "center",
        "bottom": 8,
        "inRange": {
          "color": [
            "#172554",
            "#2dd4bf"
          ]
        },
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "calculable": true,
        "formatterTemplate": "{value:thousands}"
      },
      "series": [
        {
          "type": "heatmap",
          "data": "$slot.revenue.matrix",
          "itemStyle": {
            "borderWidth": 1,
            "borderColor": "$theme.background"
          }
        }
      ]
    }
  },
  "measures": {
    "Stress Top Product Revenue": "IF(RANKX(ALL('Product Lookup'), [Total Revenue], , DESC, DENSE)<=10, [Total Revenue])"
  }
}
