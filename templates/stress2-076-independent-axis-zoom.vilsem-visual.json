{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_076_independent-axis-zoom",
      "name": "76 - Monthly revenue and profit - independent vertical zoom sliders",
      "description": "76 - Monthly revenue and profit - independent vertical zoom sliders",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      },
      "profit": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "76 - Monthly revenue and profit - independent vertical zoom sliders",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 95,
        "right": 110,
        "top": 90,
        "bottom": 95,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.values",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": [
        {
          "type": "value",
          "axisLabel": {
            "color": "#cbd5e1",
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "#263244"
            }
          },
          "name": "Revenue"
        },
        {
          "type": "value",
          "axisLabel": {
            "color": "#cbd5e1",
            "formatterTemplate": "{value:thousands}"
          },
          "splitLine": {
            "lineStyle": {
              "color": "#263244"
            }
          },
          "name": "Profit"
        }
      ],
      "series": [
        {
          "type": "bar",
          "name": "Revenue",
          "data": "$slot.revenue.values"
        },
        {
          "type": "line",
          "name": "Profit",
          "yAxisIndex": 1,
          "data": "$slot.profit.values",
          "showSymbol": false
        }
      ],
      "dataZoom": [
        {
          "type": "slider",
          "orient": "vertical",
          "yAxisIndex": [
            0
          ],
          "left": 5,
          "width": 15,
          "filterMode": "none"
        },
        {
          "type": "slider",
          "orient": "vertical",
          "yAxisIndex": [
            1
          ],
          "right": 5,
          "width": 15,
          "filterMode": "none"
        },
        {
          "type": "slider",
          "xAxisIndex": [
            0
          ],
          "bottom": 15,
          "height": 18,
          "filterMode": "none"
        }
      ]
    }
  }
}