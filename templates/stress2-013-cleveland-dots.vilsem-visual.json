{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_013_cleveland-dots",
      "name": "13 \u00b7 Country cost and revenue \u00b7 Cleveland dots",
      "description": "13 \u00b7 Country cost and revenue \u00b7 Cleveland dots",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "dimension"
      },
      "m0": {
        "kind": "measure"
      },
      "m1": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "13 \u00b7 Country cost and revenue \u00b7 Cleveland dots",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.date.categories",
        "axisLabel": {
          "color": "$theme.textPrimary"
        }
      },
      "series": [
        {
          "type": "scatter",
          "name": "Cost",
          "symbolSize": 15,
          "data": "$slot.m0.pairsSwapped"
        },
        {
          "type": "scatter",
          "name": "Revenue",
          "symbolSize": 15,
          "data": "$slot.m1.pairsSwapped"
        }
      ]
    }
  }
}
