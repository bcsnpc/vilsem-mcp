                    "args": [
                      {
                        "op": "value",
                        "args": [
                          0
                        ]
                      },
                      0
                    ]
                  },
                  "role": "label",
                  "style": {
                    "text": {
                      "op": "concat",
                      "args": [
                        {
                          "op": "value",
