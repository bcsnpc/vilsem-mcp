                        ]
                      },
                      1
                    ]
                  },
                  "role": "label",
                  "style": {
                    "text": {
                      "op": "concat",
                      "args": [
                        {
                          "op": "if",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "op": "value",
                                  "args": [
