                        {
                          "op": "formatNumber",
                          "args": [
                            {
                              "op": "value",
                              "args": [
                                2
                              ]
                            },
                            "#,0"
                          ]
                        }
                      ]
                    },
                    "x": {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              {
                                "op": "value",
                                "args": [
                                  3
                                ]
                              },
                              {
                                "op": "value",
                                "args": [
                                  4
                                ]
                              }
                            ]
                          ]
                        },
                        0
                      ]
                    },
                    "y": {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              {
                                "op": "value",
                                "args": [
                                  3
                                ]
                              },
                              {
                                "op": "value",
                                "args": [
                                  4
                                ]
                              }
                            ]
                          ]
                        },
                        1
                      ]
                    },
                    "align": "center",
                    "verticalAlign": "middle",
                    "fontSize": 14,
                    "fill": "$theme.textPrimary",
                    "width": 130,
                    "overflow": "truncate"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
