                      0
                    ]
                  },
                  "shape": {
                    "cx": 0,
                    "cy": 0,
                    "r": {
                      "op": "value",
                      "args": [
                        5
                      ]
                    }
                  },
                  "x": {
                    "op": "at",
                    "args": [
                      {
                        "op": "coord",
