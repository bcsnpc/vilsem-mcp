                              "args": [
                                2
                              ]
                            },
                            "#,0"
                          ]
                        },
                        ")"
                      ]
                    },
                    "x": {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              {
                                "op": "value",
                                "args": [
                                  3
                                ]
                              },
                              0
                            ]
                          ]
                        },
                        0
                      ]
                    },
                    "y": {
                      "op": "at",
                      "args": [
                        {
                          "op": "coord",
                          "args": [
                            [
                              0,
                              {
                                "op": "add",
                                "args": [
                                  {
                                    "op": "value",
                                    "args": [
                                      4
                                    ]
                                  },
                                  {
                                    "op": "if",
                                    "args": [
                                      {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "op": "value",
                                            "args": [
                                              1
                                            ]
                                          },
                                          2
                                        ]
                                      },
