{
  "version": 1,
  "specVersion": "0.7",
  "type": "custom",
  "bindings": {
    "dimensions": [
      {
        "table": "Product Lookup",
        "column": "ProductColor"
      },
      {
        "table": "Product Lookup",
        "column": "ProductStyle"
      },
      {
        "table": "Product Lookup",
        "column": "Price Point"
      },
      {
        "table": "Product Lookup",
        "column": "ProductKey"
      }
    ],
    "measures": [
      {
        "table": "Product Lookup",
        "name": "Venn Product Count"
      }
    ]
  },
  "measures": {
    "Venn Product Count": {
      "expression": "DISTINCTCOUNT('Product Lookup'[ProductKey])",
      "format": "#,0"
    }
  },
  "template": {
    "meta": {
      "id": "stress3-venn-expression",
      "name": "Exact three-set product overlaps",
      "formatVersion": 4
    },
    "slots": {
      "color": {
        "kind": "dimension"
      },
      "style": {
        "kind": "dimension"
      },
      "price": {
        "kind": "dimension"
      },
      "sku": {
        "kind": "dimension"
      },
      "products": {
        "kind": "measure"
      }
    },
    "transforms": [
      {
        "as": "overlap",
        "setOverlaps": {
          "value": "products",
          "sets": [
            {
              "name": "Black",
              "field": "color",
              "equals": "Black"
            },
            {
              "name": "Unisex",
              "field": "style",
              "equals": "U"
            },
            {
              "name": "High price",
              "field": "price",
              "equals": "High"
            }
          ]
        }
      }
    ],
    "template": {
      "animation": false,
      "title": {
        "text": "Product overlap — exact observed membership",
        "subtext": "Black colour / Unisex style / High price point; diagram areas are schematic, not proportional",
        "left": "center",
        "textStyle": {
          "fontSize": 18
        },
        "subtextStyle": {
          "fontSize": 11,
          "color": "#595959"
        }
      },
      "grid": {
        "left": 70,
        "right": 70,
        "top": 90,
        "bottom": 55
      },
      "tooltip": {
        "trigger": "item",
        "formatterTemplate": "{name}: {value.2:thousands}"
      },
      "xAxis": {
        "type": "value",
        "min": 0,
        "max": 1,
        "show": false
      },
      "yAxis": {
        "type": "value",
        "min": 0,
        "max": 1,
        "show": false
      },
      "series": [
        {
          "type": "custom",
          "name": "Product overlap",
          "clip": false,
          "dimensions": [
            "kind",
            "index",
            "count",
            "x",
            "y",
            "radius",
            {
              "name": "label",
              "type": "ordinal"
            }
          ],
          "encode": {
            "x": 3,
            "y": 4,
            "tooltip": 2
          },
          "data": "$calc.overlap.data",
          "renderItem": {
            "language": "vilsem-expression",
            "version": 1,
            "root": {
              "type": "group",
              "children": [
                {
                  "type": "circle",
