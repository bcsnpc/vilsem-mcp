{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_077_weekend-bands",
      "name": "77 - Daily revenue - weekend calendar bands",
      "description": "77 - Daily revenue - weekend calendar bands",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "77 - Daily revenue - weekend calendar bands",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "time",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:date}"
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "series": [
        {
          "type": "line",
          "data": "$calc.xy.data",
          "showSymbol": false,
          "markArea": {
            "silent": true,
            "label": {
              "show": false
            },
            "itemStyle": {
              "color": "#f59e0b22"
            },
            "data": "$calc.weekends.areas"
          }
        }
      ]
    },
    "transforms": [
      {
        "date": {
          "field": "date"
        },
        "as": "epoch"
      },
      {
        "points": {
          "fields": [
            "epoch",
            "revenue"
          ],
          "numeric": [
            "epoch",
            "revenue"
          ]
        },
        "as": "xy"
      },
      {
        "dateBands": {
          "field": "date",
          "weekdays": [
            0,
            6
          ]
        },
        "as": "weekends"
      }
    ]
  }
}
