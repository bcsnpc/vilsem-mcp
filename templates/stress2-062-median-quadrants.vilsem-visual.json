{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_062_median-quadrants",
      "name": "62 - Revenue / profit bubbles - median quadrants and extrema",
      "description": "62 - Revenue / profit bubbles - median quadrants and extrema",
      "formatVersion": 2
    },
    "slots": {
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      },
      "profit": {
        "kind": "measure"
      },
      "quantity": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "62 - Revenue / profit bubbles - median quadrants and extrema",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{name} | Revenue {value.0:thousands} | Profit {value.1:thousands} | Quantity {value.2:thousands}"
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "formatterTemplate": "{value:thousands}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "$theme.gridStroke"
          }
        }
      },
      "visualMap": {
        "show": false,
        "dimension": 2,
        "min": "$slot.quantity.min",
        "max": "$slot.quantity.max",
        "inRange": {
          "symbolSize": [
            12,
            60
          ]
        }
      },
      "series": [
        {
          "type": "scatter",
          "data": "$calc.xy.data",
          "label": {
            "show": true,
            "position": "top",
            "formatterTemplate": "{name}",
            "color": "$theme.textPrimary"
          },
          "markLine": {
            "symbol": "none",
            "lineStyle": {
              "color": "#f59e0b",
              "type": "dashed"
            },
            "data": [
              {
                "xAxis": "$calc.mx.first",
                "name": "Median revenue"
              },
              {
                "yAxis": "$calc.my.first",
                "name": "Median profit"
              }
            ],
            "label": {
              "position": "insideEndTop",
              "formatterTemplate": "{name}",
              "color": "#f59e0b",
              "fontSize": 10
            }
          },
          "markPoint": {
            "symbolSize": 8,
            "data": [
              {
                "type": "max",
                "valueDim": "y",
                "name": "Highest profit"
              },
              {
                "type": "min",
                "valueDim": "y",
                "name": "Lowest profit"
              }
            ],
            "label": {
              "show": true,
              "position": "bottom",
              "distance": 12,
              "formatterTemplate": "{name}",
              "fontSize": 10,
              "color": "#f59e0b"
            },
            "symbol": "circle"
          },
          "labelLayout": {
            "hideOverlap": true
          }
        }
      ]
    },
    "transforms": [
      {
        "points": {
          "fields": [
            "revenue",
            "profit",
            "quantity"
          ],
          "numeric": [
            "revenue",
            "profit",
            "quantity"
          ],
          "name": "country"
        },
        "as": "xy"
      },
      {
        "stat": {
          "field": "revenue",
          "op": "median"
        },
        "as": "mx"
      },
      {
        "stat": {
          "field": "profit",
          "op": "median"
        },
        "as": "my"
      }
    ]
  }
}
