{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_074_mirrored-funnel",
      "name": "74 - Mirrored product-category revenue funnel - 2021 / 2022",
      "description": "74 - Mirrored product-category revenue funnel - 2021 / 2022",
      "formatVersion": 2
    },
    "slots": {
      "category": {
        "kind": "dimension"
      },
      "prior": {
        "kind": "measure"
      },
      "current": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "74 - Mirrored product-category revenue funnel - 2021 / 2022",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "item",
        "confine": true,
        "formatterTemplate": "{seriesName} | {name}: {value:thousands}"
      },
      "series": [
        {
          "type": "funnel",
          "name": "2021",
          "left": "7%",
          "width": "38%",
          "top": 105,
          "bottom": 60,
          "sort": "none",
          "funnelAlign": "right",
          "max": "$calc.ceiling.max",
          "data": "$slot.prior.pieData",
          "label": {
            "show": true,
            "position": "inside",
            "formatterTemplate": "{name}",
            "color": "#fff"
          }
        },
        {
          "type": "funnel",
          "name": "2022",
          "left": "55%",
          "width": "38%",
          "top": 105,
          "bottom": 60,
          "sort": "none",
          "funnelAlign": "left",
          "max": "$calc.ceiling.max",
          "data": "$slot.current.pieData",
          "label": {
            "show": true,
            "position": "inside",
            "formatterTemplate": "{name}",
            "color": "#fff"
          }
        }
      ],
      "graphic": [
        {
          "type": "text",
          "left": "22%",
          "top": 77,
          "style": {
            "text": "2021",
            "fill": "#e2e8f0",
            "fontSize": 14
          }
        },
        {
          "type": "text",
          "left": "70%",
          "top": 77,
          "style": {
            "text": "2022",
            "fill": "#e2e8f0",
            "fontSize": 14
          }
        }
      ]
    },
    "transforms": [
      {
        "calculate": "max(prior,current)",
        "as": "ceiling"
      }
    ]
  },
  "measures": {
    "Stress Funnel 2021": "CALCULATE([Total Revenue], FILTER(ALL('Calendar Lookup'), YEAR('Calendar Lookup'[Date])=2021))",
    "Stress Funnel 2022": "CALCULATE([Total Revenue], FILTER(ALL('Calendar Lookup'), YEAR('Calendar Lookup'[Date])=2022))"
  }
}