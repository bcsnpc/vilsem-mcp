{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_037_calendar-margin",
      "name": "37 - Daily profit margin - calendar 2022",
      "description": "37 - Daily profit margin - calendar 2022",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "value": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "37 - Daily profit margin - calendar 2022",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "item",
        "confine": true
      },
      "calendar": {
        "range": "2022",
        "left": 75,
        "right": 45,
        "top": 150,
        "cellSize": [
          "auto",
          40
        ],
        "yearLabel": {
          "show": false
        },
        "dayLabel": {
          "color": "#cbd5e1"
        },
        "monthLabel": {
          "color": "#cbd5e1"
        },
        "itemStyle": {
          "color": "#111827",
          "borderColor": "#0b0b12",
          "borderWidth": 2
        },
        "splitLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "visualMap": {
        "min": "$slot.value.min",
        "max": "$slot.value.max",
        "orient": "horizontal",
        "left": "center",
        "bottom": 65,
        "inRange": {
          "color": [
            "#172554",
            "#2dd4bf"
          ]
        },
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "series": [
        {
          "type": "heatmap",
          "coordinateSystem": "calendar",
          "data": "$slot.value.pairs"
        }
      ]
    }
  },
  "measures": {
    "Stress 2022 Daily Margin": "IF(YEAR(MAX('Calendar Lookup'[Date]))=2022, DIVIDE([Total Profit],[Total Revenue]))"
  }
}