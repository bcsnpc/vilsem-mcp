{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_072_event-timeline",
      "name": "72 - Sampled order events - real order-number annotations by country",
      "description": "72 - Sampled order events - real order-number annotations by country",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "owner": {
        "kind": "dimension"
      },
      "order": {
        "kind": "dimension"
      },
      "quantity": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "72 - Sampled order events - real order-number annotations by country",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "scale": true,
        "boundaryGap": [
          "10%",
          "10%"
        ],
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:date}"
        }
      },
      "yAxis": {
        "type": "category",
        "data": "$slot.owner.categories",
        "axisLabel": {
          "color": "#cbd5e1"
        }
      },
      "series": [
        {
          "type": "scatter",
          "data": "$calc.events.data",
          "symbol": "diamond",
          "symbolSize": 12,
          "label": {
            "show": true,
            "position": "top",
            "rotate": 40,
            "fontSize": 9,
            "formatterTemplate": "{name}",
            "color": "#e2e8f0"
          },
          "labelLayout": {
            "hideOverlap": true
          }
        }
      ]
    },
    "transforms": [
      {
        "date": {
          "field": "date"
        },
        "as": "dates"
      },
      {
        "points": {
          "fields": [
            "dates",
            "owner",
            "quantity"
          ],
          "numeric": [
            "dates",
            "quantity"
          ],
          "name": "order",
          "sample": 24
        },
        "as": "events"
      }
    ]
  }
}