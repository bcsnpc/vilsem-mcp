{
  "version": 1,
  "type": "custom",
  "canvasTheme": "dark",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_069_normalized-area",
      "name": "69 - Country share of monthly revenue - normalized stacked area",
      "description": "69 - Country share of monthly revenue - normalized stacked area",
      "formatVersion": 2
    },
    "slots": {
      "date": {
        "kind": "time"
      },
      "country": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": [
        "#2dd4bf",
        "#60a5fa",
        "#f59e0b",
        "#f472b6",
        "#a78bfa",
        "#a3e635"
      ],
      "textStyle": {
        "color": "#e2e8f0",
        "fontFamily": "Segoe UI"
      },
      "title": {
        "text": "69 - Country share of monthly revenue - normalized stacked area",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "#f8fafc"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "#cbd5e1"
        }
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 75,
        "right": 40,
        "top": 90,
        "bottom": 75,
        "containLabel": true
      },
      "xAxis": {
        "type": "category",
        "data": "$slot.date.categories",
        "axisLabel": {
          "color": "#cbd5e1",
          "rotate": 35,
          "hideOverlap": true,
          "formatterTemplate": "{value:date}"
        },
        "axisLine": {
          "lineStyle": {
            "color": "#64748b"
          }
        }
      },
      "yAxis": {
        "type": "value",
        "axisLabel": {
          "color": "#cbd5e1",
          "formatterTemplate": "{value:percent}"
        },
        "splitLine": {
          "lineStyle": {
            "color": "#263244"
          }
        },
        "min": 0,
        "max": 1
      },
      "series": {
        "repeat": "$calc.panels.panels",
        "template": {
          "type": "line",
          "name": "$item.name",
          "stack": "share",
          "data": "$item.data",
          "symbol": "none",
          "areaStyle": {
            "opacity": 0.8
          }
        }
      }
    },
    "transforms": [
      {
        "window": {
          "field": "revenue",
          "op": "percentOfTotal",
          "partitionBy": "date"
        },
        "as": "share"
      },
      {
        "facet": {
          "by": "country",
          "category": "date",
          "value": "share"
        },
        "as": "panels"
      }
    ]
  }
}