{
  "version": 1,
  "type": "custom",
  "config": {
    "cardStyle": "plain"
  },
  "template": {
    "meta": {
      "id": "stress2_086_ranked-inline-bars",
      "name": "86 - Twelve highest-revenue product models - inline ranked bars",
      "description": "86 - Twelve highest-revenue product models - inline ranked bars",
      "formatVersion": 3
    },
    "slots": {
      "model": {
        "kind": "dimension"
      },
      "revenue": {
        "kind": "measure"
      }
    },
    "params": [],
    "template": {
      "animation": false,
      "backgroundColor": "$theme.background",
      "color": "$theme.palette",
      "textStyle": {
        "color": "$theme.textPrimary",
        "fontFamily": "$theme.font"
      },
      "title": {
        "text": "86 - Twelve highest-revenue product models - inline ranked bars",
        "left": 18,
        "top": 12,
        "textStyle": {
          "fontSize": 17,
          "color": "$theme.textPrimary"
        }
      },
      "legend": {
        "top": 42,
        "textStyle": {
          "color": "$theme.textPrimary"
        },
        "show": false
      },
      "tooltip": {
        "trigger": "axis",
        "confine": true
      },
      "grid": {
        "left": 210,
        "right": 130,
        "top": 90,
        "bottom": 50,
        "containLabel": true
      },
      "xAxis": {
        "type": "value",
        "show": false
      },
      "yAxis": {
        "type": "category",
        "inverse": true,
        "data": "$calc.ranked.categories",
        "axisLabel": {
          "color": "$theme.textPrimary",
          "width": 185,
          "overflow": "truncate"
        },
        "axisTick": {
          "show": false
        },
        "axisLine": {
          "show": false
        }
      },
      "series": [
        {
          "type": "bar",
          "name": "Revenue",
          "data": "$calc.ranked.pieData",
          "barWidth": 17,
          "label": {
            "show": true,
            "position": "right",
            "formatterTemplate": "{value:thousands}",
            "color": "$theme.textPrimary"
          }
        }
      ]
    },
    "transforms": [
      {
        "top": {
          "category": "model",
          "value": "revenue",
          "count": 12,
          "other": false
        },
        "as": "ranked"
      }
    ]
  }
}
