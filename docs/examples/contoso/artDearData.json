 "bindings": {
  "dimensions": [
   {
    "table": "Date",
    "column": "Date"
   }
  ],
  "measures": [
   {
    "name": "ddM",
    "scoped": true
   },
   {
    "name": "ddD",
    "scoped": true
   },
   {
    "name": "ddR",
    "scoped": true
   },
   {
    "name": "ddW",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "ddM": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) = y && NOT ISBLANK(s), MONTH(d) - 1)",
    "format": "0"
   },
   "ddD": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) = y && NOT ISBLANK(s), DAY(d))",
    "format": "0"
   },
   "ddR": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] VAR a = CALCULATE(DIVIDE([Net Sales], COUNTROWS(VALUES('Date'[Date]))), REMOVEFILTERS('Date'), 'Date'[Year] = y, 'Date'[MonthNumber] = MONTH(d)) RETURN IF(YEAR(d) = y && NOT ISBLANK(s), DIVIDE(s, a))",
    "format": "0.00\"x\""
   },
   "ddW": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) = y && NOT ISBLANK(s), WEEKDAY(d, 2))",
    "format": "0"
   }
  },
