{
 "_note": "Working Vilsem spec from the Contoso 10M demo report (renderer 4.43). Contoso-specific fields/measures; use as a reference, not a shipped template.",
 "visual": "artFlowers",
 "layout": {
  "x": 640,
  "y": 720,
  "width": 640,
  "height": 720,
  "z": 3,
  "tabOrder": 3
 },
 "bindings": {
  "dimensions": [
   {
    "table": "Product",
    "column": "CategoryName"
   },
   {
    "table": "Date",
    "column": "MonthNumber"
   }
  ],
  "measures": [
   {
    "name": "flC",
    "scoped": true
   },
   {
    "name": "flM",
    "scoped": true
   },
   {
    "name": "flL",
    "scoped": true
   },
   {
    "name": "flG",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "flC": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) RETURN IF(NOT ISBLANK([Net Sales]), RANKX(ALLSELECTED(Product[CategoryName]), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y), 0), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y), 0), DESC) - 1)",
    "format": "0"
   },
   "flM": {
    "expression": "IF(NOT ISBLANK([Net Sales]), MAX('Date'[MonthNumber]))",
    "format": "0"
   },
   "flL": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR s = CALCULATE([Net Sales], 'Date'[Year] = y) VAR m = MAXX(CROSSJOIN(ALLSELECTED(Product[CategoryName]), ALLSELECTED('Date'[MonthNumber])), CALCULATE([Net Sales], 'Date'[Year] = y)) RETURN DIVIDE(s, m)",
    "format": "0.00"
   },
   "flG": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR s = CALCULATE([Net Sales], 'Date'[Year] = y) VAR p = CALCULATE([Net Sales], 'Date'[Year] = y - 1) RETURN IF(s > 0, DIVIDE(s, p) - 1)",
    "format": "+0%;-0%"
   }
  },
