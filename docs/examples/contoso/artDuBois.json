 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "duS": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) RETURN CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) / 1e6",
    "format": "\"$\"#,0\"M\""
   },
   "duSh": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR s = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) VAR m = MAXX(ALLSELECTED(Customer[CountryFull]), CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y)) RETURN DIVIDE(s, m)",
    "format": "0.00"
   },
   "duR": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) RETURN IF(NOT ISBLANK([Net Sales]), RANKX(ALLSELECTED(Customer[CountryFull]), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y), 0), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y), 0), DESC))",
    "format": "0"
   }
  },
