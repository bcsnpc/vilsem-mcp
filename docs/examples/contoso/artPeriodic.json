{
 "_note": "Working Vilsem spec from the Contoso 10M demo report (renderer 4.43). Contoso-specific fields/measures; use as a reference, not a shipped template.",
 "visual": "artPeriodic",
 "layout": {
  "x": 0,
  "y": 1440,
  "width": 640,
  "height": 720,
  "z": 4,
  "tabOrder": 4
 },
 "bindings": {
  "dimensions": [
   {
    "table": "Product",
    "column": "SubCategoryName"
   },
   {
    "table": "Product",
    "column": "CategoryName"
   }
  ],
  "measures": [
   {
    "name": "ptC",
    "scoped": true
   },
   {
    "name": "ptR",
    "scoped": true
   },
   {
    "name": "ptN",
    "scoped": true
   },
   {
    "name": "ptS",
    "scoped": true
   },
   {
    "name": "ptG",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "ptC": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR f = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) RETURN IF(f > 0, SWITCH(SELECTEDVALUE(Product[CategoryName]), \"Home Appliances\", 0, \"Computers\", 1, \"Cell phones\", 2, \"Audio\", 3, \"Music, Movies and Audio Books\", 4, \"Games and Toys\", 5, \"TV and Video\", 6, \"Cameras and camcorders\", 7))",
    "format": "0"
   },
   "ptR": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR f = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) RETURN IF(f > 0, 8 - RANKX(CALCULATETABLE(VALUES(Product[SubCategoryName]), REMOVEFILTERS(Product[SubCategoryName])), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y), 0), ROUND(f, 0), DESC))",
    "format": "0"
   },
   "ptN": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR f = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) RETURN IF(f > 0, RANKX(CALCULATETABLE(VALUES(Product[SubCategoryName]), REMOVEFILTERS(Product[SubCategoryName], Product[CategoryName])), ROUND(CALCULATE([Net Sales], REMOVEFILTERS('Date'), REMOVEFILTERS(Product[CategoryName]), 'Date'[Year] = y), 0), ROUND(f, 0), DESC))",
    "format": "0"
   },
   "ptS": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR f = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) RETURN IF(f > 0, f / 1e6)",
    "format": "\"$\"#,0.0\"M\""
   },
   "ptG": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR f = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) VAR p = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y - 1) RETURN IF(f > 0, DIVIDE(f, p) - 1)",
    "format": "+0%;-0%"
   }
  },
