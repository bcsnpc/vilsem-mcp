{
 "_note": "Working Vilsem spec from the Contoso 10M demo report (renderer 4.43). Contoso-specific fields/measures; use as a reference, not a shipped template.",
 "visual": "liveBrandRace",
 "layout": {
  "x": 0,
  "y": 0,
  "width": 640,
  "height": 630,
  "z": 0,
  "tabOrder": 0
 },
 "bindings": {
  "dimensions": [
   {
    "table": "Date",
    "column": "Year"
   },
   {
    "table": "Product",
    "column": "Brand"
   }
  ],
  "measures": [
   {
    "name": "lvCum",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "lvCum": {
    "expression": "VAR y = MAX('Date'[Year]) VAR last = YEAR([Global Last Sale Date]) RETURN IF(y <= last && NOT ISBLANK([Net Sales]), CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] <= y) / 1e6)",
    "format": "\"$\"#,0\"M\""
   }
  },
  "template": {
   "meta": {
    "id": "live_brand_race",
    "name": "Brand race to the top",
    "formatVersion": 4
   },
   "slots": {
    "year": {
     "kind": "dimension"
    },
    "brand": {
     "kind": "dimension"
    },
    "s": {
     "kind": "measure"
    }
   },
   "params": [],
   "transforms": [
    {
     "as": "race",
     "race": {
      "time": "year",
      "category": "brand",
      "value": "s",
      "topN": 11
     }
    }
   ],
   "animation": {
    "enter": {
     "duration": 300
    },
    "update": {
     "duration": 900,
     "easing": "cubicInOut"
    }
   },
   "template": {
    "baseOption": {
     "backgroundColor": "#0B1220",
     "textStyle": {
      "fontFamily": "$theme.font",
      "color": "#E6EDF7"
     },
     "color": [
      "#38BDF8"
     ],
     "timeline": {
      "axisType": "category",
      "autoPlay": true,
      "playInterval": 1100,
      "loop": true,
      "bottom": 14,
      "left": 40,
      "right": 40,
      "data": "$calc.race.labels",
      "label": {
       "color": "#8FA3C7"
      },
      "lineStyle": {
       "color": "#26324A"
      },
      "itemStyle": {
       "color": "#38BDF8"
      },
      "checkpointStyle": {
       "color": "#FBBF24",
       "borderColor": "#FBBF24"
      },
      "controlStyle": {
       "color": "#8FA3C7",
       "borderColor": "#8FA3C7"
      },
      "progress": {
       "lineStyle": {
        "color": "#38BDF8"
       },
       "itemStyle": {
        "color": "#38BDF8"
       }
      }
     },
     "grid": {
      "left": 160,
      "right": 90,
      "top": 120,
      "bottom": 90
     },
     "tooltip": {
      "trigger": "item",
      "confine": true
     },
     "xAxis": {
      "type": "value",
      "max": "$calc.race.maxValue",
      "axisLabel": {
       "color": "#8FA3C7",
       "formatterTemplate": "{value:thousands}"
      },
      "splitLine": {
       "lineStyle": {
        "color": "#1B2538"
       }
      }
     },
     "yAxis": {
      "type": "category",
      "inverse": true,
      "axisLine": {
       "show": false
      },
      "axisTick": {
       "show": false
      },
      "animationDuration": 300,
      "animationDurationUpdate": 300
     }
    },
    "options": {
     "repeat": "$calc.race.frames",
     "template": {
      "title": [
       {
        "text": "BRAND RACE",
        "left": 28,
        "top": 22,
        "textStyle": {
         "fontSize": 11,
         "fontWeight": 800,
         "color": "#38BDF8"
        }
       },
       {
        "text": "Cumulative net sales since 2016",
        "left": 28,
        "top": 40,
        "textStyle": {
         "fontSize": 22,
         "fontWeight": 800,
         "color": "#FFFFFF"
        }
       },
       {
        "text": "$item.label",
        "right": 40,
        "bottom": 100,
        "textStyle": {
         "fontSize": 64,
         "fontWeight": 900,
         "color": "rgba(255,255,255,0.12)"
        }
       }
      ],
      "yAxis": {
       "data": "$item.categories",
       "axisLabel": {
        "color": "#E6EDF7",
        "fontSize": 12,
        "fontWeight": 700
       }
      },
      "series": [
       {
        "id": "brand-race",
        "type": "bar",
        "data": "$item.data",
        "realtimeSort": true,
        "barCategoryGap": "28%",
        "itemStyle": {
         "borderRadius": [
          0,
          6,
          6,
          0
         ],
         "color": {
          "type": "linear",
          "x": 0,
          "y": 0,
          "x2": 1,
          "y2": 0,
          "colorStops": [
           {
            "offset": 0,
            "color": "#1D4ED8"
           },
           {
            "offset": 1,
            "color": "#38BDF8"
           }
          ]
         }
        },
        "label": {
         "show": true,
         "position": "right",
         "color": "#E6EDF7",
         "fontWeight": 700,
         "formatterTemplate": "{value:thousands}"
        }
       }
      ]
     }
    }
   }
  },
  "specVersion": "0.7",
  "bindings": {
   "dimensions": [
    {
     "table": "Date",
     "column": "Year"
    },
    {
     "table": "Product",
     "column": "Brand"
    }
   ],
   "measures": [
    {
     "table": "KPI Measures",
     "name": "lvCum"
    }
   ]
  }
 }
}