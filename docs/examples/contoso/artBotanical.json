{
 "_note": "Working Vilsem spec from the Contoso 10M demo report (renderer 4.43). Contoso-specific fields/measures; use as a reference, not a shipped template.",
 "visual": "artBotanical",
 "layout": {
  "x": 640,
  "y": 2160,
  "width": 640,
  "height": 720,
  "z": 7,
  "tabOrder": 7
 },
 "bindings": {
  "dimensions": [
   {
    "table": "Store",
    "column": "Description"
   }
  ],
  "measures": [
   {
    "name": "bsX",
    "scoped": true
   },
   {
    "name": "bsH",
    "scoped": true
   },
   {
    "name": "bsS",
    "scoped": true
   },
   {
    "name": "bsC",
    "scoped": true
   },
   {
    "name": "bsL",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "bsX": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = SELECTEDVALUE(Store[Description]) VAR life = [Net Sales] VAR ok = d <> \"Online store\" && life > 0 RETURN IF(ok, RANKX(FILTER(ALLSELECTED(Store[Description]), Store[Description] <> \"Online store\" && CALCULATE([Net Sales]) > 0), CALCULATE(INT(MIN(Store[OpenDate])) * 1000 + MOD(MIN(Store[StoreKey]), 1000)), , ASC, Dense))",
    "format": "0"
   },
   "bsH": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = SELECTEDVALUE(Store[Description]) VAR life = [Net Sales] VAR ok = d <> \"Online store\" && life > 0 VAR o = CALCULATE(MIN(Store[OpenDate])) VAR e = CALCULATE(MAX(Sales[OrderDate]), REMOVEFILTERS('Date')) RETURN IF(ok, DIVIDE(INT(e - o), 365.25))",
    "format": "0.0\" yrs\""
   },
   "bsS": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = SELECTEDVALUE(Store[Description]) VAR life = [Net Sales] VAR ok = d <> \"Online store\" && life > 0 RETURN IF(ok, COALESCE(CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = y) / 1e6, 0))",
    "format": "\"$\"#,0.0\"M\""
   },
   "bsC": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = SELECTEDVALUE(Store[Description]) VAR life = [Net Sales] VAR ok = d <> \"Online store\" && life > 0 RETURN IF(ok, SWITCH(SELECTEDVALUE(Store[CountryName]), \"Australia\", 0, \"Canada\", 1, \"France\", 2, \"Germany\", 3, \"Italy\", 4, \"Netherlands\", 5, \"United Kingdom\", 6, \"United States\", 7, 0))",
    "format": "0"
   },
   "bsL": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = SELECTEDVALUE(Store[Description]) VAR life = [Net Sales] VAR ok = d <> \"Online store\" && life > 0 RETURN IF(ok, CALCULATE([Net Sales], REMOVEFILTERS('Date')) / 1e6)",
    "format": "\"$\"#,0\"M\""
   }
  },
  "template": {
