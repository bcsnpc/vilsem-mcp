 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "upD": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) >= y - 2 && YEAR(d) <= y && NOT ISBLANK(s), DAY(d))",
    "format": "0"
   },
   "upL": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) >= y - 2 && YEAR(d) <= y && NOT ISBLANK(s), (YEAR(d) - y + 2) * 12 + MONTH(d) - 1)",
    "format": "0"
   },
   "upV": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] RETURN IF(YEAR(d) >= y - 2 && YEAR(d) <= y && NOT ISBLANK(s), ROUND(s / 1e6, 2))",
    "format": "0.0"
   },
   "upN": {
    "expression": "VAR y = YEAR([Global Last Sale Date]) VAR d = MAX('Date'[Date]) VAR s = [Net Sales] VAR nx = CALCULATE([Net Sales], 'Date'[Date] = d + 1) RETURN IF(YEAR(d) >= y - 2 && YEAR(d) <= y && NOT ISBLANK(s), IF(MONTH(d + 1) = MONTH(d), ROUND(COALESCE(nx, 0) / 1e6, 2), -1))",
    "format": "0.0"
   }
  },
