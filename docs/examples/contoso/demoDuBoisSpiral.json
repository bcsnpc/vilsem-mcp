 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "dbSales": {
    "expression": "VAR last = [Global Last Sale Date] VAR fy = IF(MONTH(last) = 12 && DAY(last) = 31, YEAR(last), YEAR(last) - 1) RETURN CALCULATE([Net Sales], KEEPFILTERS('Date'[Year] = fy)) / 1e6",
    "format": "\"$\"#,0\"M\""
   },
   "dbFrac": {
    "expression": "IF(NOT ISBLANK([dbSales]), DIVIDE([dbSales], MAXX(ALLSELECTED(Customer[CountryFull]), [dbSales])))",
    "format": "0.000"
   },
   "dbRank": {
    "expression": "IF(NOT ISBLANK([dbSales]), RANKX(ALLSELECTED(Customer[CountryFull]), [dbSales], , DESC))",
    "format": "0"
   },
   "dbYear": {
    "expression": "VAR last = [Global Last Sale Date] VAR fy = IF(MONTH(last) = 12 && DAY(last) = 31, YEAR(last), YEAR(last) - 1) RETURN IF(NOT ISBLANK([dbSales]), fy)",
    "format": "0"
   }
  },
