    "textStyle": {
     "fontFamily": "Georgia, 'Times New Roman', serif",
     "color": "#1B1B1B"
    },
    "title": [
     {
      "text": "CARTE FIGURATIVE",
      "left": "center",
      "top": 24,
      "textStyle": {
       "fontSize": 17,
       "fontWeight": 700,
       "color": "#1B1B1B",
       "fontFamily": "Georgia, 'Times New Roman', serif"
      }
     },
     {
      "text": "des pertes successives en clients de la cohorte 2016, année par année",
      "left": "center",
      "top": 48,
      "textStyle": {
       "fontSize": 11,
       "fontStyle": "italic",
       "color": "#3A3020",
       "fontFamily": "Georgia, 'Times New Roman', serif"
      }
     },
     {
      "text": "Tan band = 2016 customers still buying (width = head-count)  ·  black band = what they spent  ·  line = share still active",
      "left": "center",
      "top": 68,
      "textStyle": {
       "fontSize": 9.5,
       "color": "#5A4E3C",
       "fontFamily": "Georgia, 'Times New Roman', serif"
      }
     },
     {
      "text": "After Charles Joseph Minard, Napoleon's march on Moscow, 1869",
      "left": "center",
      "bottom": 10,
