{
 "_note": "Working Vilsem spec from the Contoso 10M demo report (renderer 4.43). Contoso-specific fields/measures; use as a reference, not a shipped template.",
 "visual": "artMinard",
 "layout": {
  "x": 0,
  "y": 2160,
  "width": 640,
  "height": 720,
  "z": 6,
  "tabOrder": 6
 },
 "bindings": {
  "dimensions": [
   {
    "table": "Date",
    "column": "Year"
   }
  ],
  "measures": [
   {
    "name": "mnA",
    "scoped": true
   },
   {
    "name": "mnS",
    "scoped": true
   },
   {
    "name": "mnR",
    "scoped": true
   }
  ]
 },
 "spec": {
  "version": 1,
  "type": "custom",
  "config": {
   "cardStyle": "plain",
   "renderer": "svg"
  },
  "measures": {
   "mnA": {
    "expression": "VAR f = YEAR(CALCULATE(MIN(Sales[OrderDate]), REMOVEFILTERS('Date'))) VAR c0 = CALCULATETABLE(VALUES(Sales[CustomerKey]), REMOVEFILTERS('Date'), 'Date'[Year] = f) VAR yr = MAX('Date'[Year]) VAR a = COUNTROWS(INTERSECT(CALCULATETABLE(VALUES(Sales[CustomerKey]), REMOVEFILTERS('Date'), 'Date'[Year] = yr), c0)) RETURN IF(a > 0, a)",
    "format": "#,0"
   },
   "mnS": {
    "expression": "VAR f = YEAR(CALCULATE(MIN(Sales[OrderDate]), REMOVEFILTERS('Date'))) VAR c0 = CALCULATETABLE(VALUES(Sales[CustomerKey]), REMOVEFILTERS('Date'), 'Date'[Year] = f) VAR yr = MAX('Date'[Year]) VAR s = CALCULATE([Net Sales], REMOVEFILTERS('Date'), 'Date'[Year] = yr, TREATAS(c0, Sales[CustomerKey])) / 1e6 RETURN IF(s > 0, s)",
    "format": "\"$\"#,0\"M\""
   },
   "mnR": {
    "expression": "VAR f = YEAR(CALCULATE(MIN(Sales[OrderDate]), REMOVEFILTERS('Date'))) VAR c0 = CALCULATETABLE(VALUES(Sales[CustomerKey]), REMOVEFILTERS('Date'), 'Date'[Year] = f) VAR yr = MAX('Date'[Year]) VAR a = COUNTROWS(INTERSECT(CALCULATETABLE(VALUES(Sales[CustomerKey]), REMOVEFILTERS('Date'), 'Date'[Year] = yr), c0)) RETURN IF(a > 0, DIVIDE(a, COUNTROWS(c0)))",
    "format": "0%"
   }
  },
  "template": {
   "meta": {
    "id": "art_minard_march",
    "name": "Minard cohort march",
    "formatVersion": 4
   },
   "slots": {
    "year": {
     "kind": "time"
    },
    "a": {
     "kind": "measure"
    },
    "s": {
     "kind": "measure"
    },
    "r": {
     "kind": "measure"
    }
   },
   "params": [],
   "transforms": [
    {
     "window": {
      "op": "lag",
      "field": "a",
      "orderBy": "year",
      "offset": 1,
      "default": -1
     },
     "as": "pa"
    },
    {
     "window": {
      "op": "lag",
      "field": "s",
      "orderBy": "year",
      "offset": 1,
      "default": 0
     },
     "as": "ps"
    },
    {
     "window": {
      "op": "lag",
      "field": "r",
      "orderBy": "year",
      "offset": 1,
      "default": 0
     },
     "as": "pr"
    },
    {
     "points": {
      "fields": [
       "a",
       "pa",
       "s",
       "ps",
       "r",
       "pr"
      ],
      "numeric": [
       "a",
